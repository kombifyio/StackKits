package immich_kiosk

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "immich-kiosk"
		displayName: "Immich Kiosk"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Slideshow of Immich albums and people for picture frames, TVs and browsers."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "64m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: "immich-kiosk": foundation.#ServiceDefinition & {
		name:     "immich-kiosk"
