		tag:      "0.44.1"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`kiosk.{{.domain}}`)"
				port:    3000
			}
			networks: ["immich-internal"]
		}

		accessPolicy: {
			outerAuth: "tinyauth-pocketid"
			appAuth:   "none"
			reason:    "Read-only slideshow; Kiosk has no user store, so the gateway login protects it."
		}

		upstream: {
			github: repo:    "damongolding/immich-kiosk"
			registry: image: "ghcr.io/damongolding/immich-kiosk"
			track: "minor"
		}

		healthCheck: {
			enabled: true
			http: {
				path:   "/health"
				port:   3000
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "64m"
			memoryMax: "256m"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Immich Kiosk dashboard"
	}
}

