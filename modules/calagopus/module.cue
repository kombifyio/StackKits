// Package calagopus — Calagopus Panel module (scaffolded, draft).
//
// Calagopus Panel and Wings upstream catalog, the recommended Game platform. The native-v2 game workload owns executable configuration, owner bootstrap and the governed Wings lifecycle-owner approval (ADR-0043, ADR-0048).
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package calagopus

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "calagopus"
		displayName: "Calagopus Panel"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Calagopus Panel and Wings upstream catalog, the recommended Game platform. The native-v2 game workload owns executable configuration, owner bootstrap and the governed Wings lifecycle-owner approval (ADR-0043, ADR-0048)."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "768m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: {
		panel: foundation.#ServiceDefinition & {
			name:     "panel"
			type:     "application"
			image:    "ghcr.io/calagopus/panel"
			tag:      "1.2.4@sha256:95ee4a9ea6b3c1567179610ca8f5637f7e8d7f6bc4f97a4207afba6b9cd21d1a"
			required: false
			status:   "implemented"

			network: {
				traefik: {
					enabled: true
					rule:    "Host(`game.{{.domain}}`)"
					port:    8000
				}
				networks: ["game-internal"]
			}

			accessPolicy: {
				outerAuth: "self"
				appAuth:   "self-auth"
			}

			upstream: {
				github: repo: "calagopus/panel"
				registry: image: "ghcr.io/calagopus/panel"
				track: "minor"
			}

			volumes: [
				{
					source: "panel-data"
					target: "/var/lib/calagopus"
					type:   "volume"
					backup: true
				},
			]

			healthCheck: {
				enabled: true
				http: {
					path:   "/"
					port:   8000
					scheme: "http"
				}
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			resources: {
				memory:    "128m"
				memoryMax: "512m"
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Calagopus Panel dashboard"
		}
		"panel-database": foundation.#ServiceDefinition & {
			name:     "panel-database"
			type:     "database"
			image:    "docker.io/library/postgres"
			tag:      "18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873"
			required: false
			status:   "implemented"

			network: networks: ["game-internal"]

			upstream: {
				github: repo: "docker-library/postgres"
				registry: image: "docker.io/library/postgres"
				track: "minor"
			}

			volumes: [
				{
					source: "panel-database-data"
					target: "/var/lib/postgresql"
					type:   "volume"
					backup: true
				},
			]

			healthCheck: {
				enabled:  true
				command:  "pg_isready -U panel -d panel"
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			resources: {
				memory:    "128m"
				memoryMax: "512m"
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Calagopus Panel database (internal)"
		}
		"panel-cache": foundation.#ServiceDefinition & {
			name:     "panel-cache"
			type:     "cache"
			image:    "docker.io/valkey/valkey"
			tag:      "9-alpine@sha256:a0dbf4c1d5708782907c10e2c72deff317518518b5288a58416981d9db95d30b"
			required: false
			status:   "implemented"

			network: networks: ["game-internal"]

			upstream: {
				github: repo: "valkey-io/valkey"
				registry: image: "docker.io/valkey/valkey"
				track: "minor"
			}

			volumes: [
				{
					source: "panel-cache-data"
					target: "/data"
					type:   "volume"
					backup: false
				},
			]

			healthCheck: {
				enabled:  true
				command:  "valkey-cli ping"
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			resources: {
				memory:    "64m"
				memoryMax: "256m"
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Calagopus Panel cache (internal)"
		}
		wings: foundation.#ServiceDefinition & {
			name:     "wings"
			type:     "application"
			image:    "ghcr.io/calagopus/wings"
			tag:      "1.2.4@sha256:61417524f2701e0fa614c0816f219268c7ae1043d4d45b07bbbbacbe781c2e5a"
			required: false
			status:   "implemented"

			network: networks: ["game-internal"]

			upstream: {
				github: repo: "calagopus/wings"
				registry: image: "ghcr.io/calagopus/wings"
				track: "minor"
			}

			volumes: [
				{
					source: "wings-data"
					target: "/stackkit/game-data"
					type:   "volume"
					backup: true
				},
			]

			healthCheck: {
				enabled: true
				http: {
					path:   "/api/system"
					port:   8080
					scheme: "http"
				}
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			resources: {
				memory:    "128m"
				memoryMax: "512m"
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Calagopus Panel application (internal)"
		}
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of calagopus (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-calagopus-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-calagopus-runtime"
	workloadRef:    "game"
	alternativeRef: "calagopus"
	release:        "1.2.4"
	entryComponent: "panel"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: requiredSafetyInit: ["panel-bootstrap", "panel-keys", "wings-bootstrap"]
	route: {
		serviceRef:        "game"
		targetPort:        8000
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "calagopus-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {
		"database-password": purpose: "Custody secret slot database-password for calagopus"
	}
	backup: {
		volumes: [
			{componentRef: "panel", volumeRef: "data"},
			{componentRef: "panel-database", volumeRef: "database"},
			{componentRef: "wings-bootstrap", volumeRef: "data"},
			{componentRef: "wings", volumeRef: "data"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"game-internal": {}
	}
	components: [
		{
			id:        "panel"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["panel"]
			entrypoint: ["/bin/sh", "/stackkit/panel-entrypoint.sh"]
			dependsOn: ["panel-cache", "panel-database"]
			environment: {
				APP_ENABLE_WINGS_PROXY: "true"
				APP_LOG_DIRECTORY: "/var/log/calagopus"
				APP_PRIMARY: "true"
				APP_USE_DECRYPTION_CACHE: "false"
				APP_USE_INTERNAL_CACHE: "true"
				DATABASE_MIGRATE: "true"
				PORT: "8000"
				REDIS_URL: "redis://panel-cache"
				TZ: "UTC"
			}
			secretEnvironment: {}
			volumes: [
				{id: "data", target: "/var/lib/calagopus", class: "persistent", backup: true},
				{id: "logs", target: "/var/log/calagopus", class: "cache"},
				{id: "stackkit", target: "/stackkit", class: "cache"},
			]
			networks: ["game-internal"]
			health: {kind: "http", path: "/", port: 8000}
			resources: {memoryLimit: "512m", memoryReservation: "128m"}
			labels: {}
			traits: {}
		},
		{
			id:        "panel-database"
			role:      "database"
			lifecycle: "daemon"
			image:     _images["panel-database"]
			environment: {
				POSTGRES_DB: "panel"
				POSTGRES_USER: "panel"
			}
			secretEnvironment: {
				POSTGRES_PASSWORD: "database-password"
			}
			volumes: [
				{id: "database", target: "/var/lib/postgresql", class: "persistent", backup: true},
			]
			networks: ["game-internal"]
			health: {kind: "command", command: ["pg_isready", "-U", "panel", "-d", "panel"]}
			resources: {memoryLimit: "512m", memoryReservation: "128m"}
			labels: {}
			traits: {}
		},
		{
			id:        "panel-cache"
			role:      "cache"
			lifecycle: "daemon"
			image:     _images["panel-cache"]
			command: ["valkey-server"]
			environment: {}
			secretEnvironment: {}
			volumes: [
				{id: "cache", target: "/data", class: "cache"},
			]
			networks: ["game-internal"]
			health: {kind: "command", command: ["valkey-cli", "ping"]}
			resources: {memoryLimit: "256m", memoryReservation: "64m"}
			labels: {}
			traits: {}
		},
		{
			id:        "panel-bootstrap"
			role:      "database-init"
			lifecycle: "one-shot"
			image:     _images["panel-bootstrap"]
			entrypoint: ["/bin/sh"]
			command: ["/stackkit/bootstrap-owner.sh"]
			dependsOn: ["panel"]
			environment: {
				APP_ENABLE_WINGS_PROXY: "true"
				APP_LOG_DIRECTORY: "/var/log/calagopus"
				APP_PRIMARY: "true"
				APP_USE_DECRYPTION_CACHE: "false"
				APP_USE_INTERNAL_CACHE: "true"
				DATABASE_MIGRATE: "true"
				PORT: "8000"
				REDIS_URL: "redis://panel-cache"
				TZ: "UTC"
			}
			secretEnvironment: {}
			volumes: [
				{id: "stackkit", target: "/stackkit", class: "cache"},
			]
			networks: ["game-internal"]
			health: {kind: "completion"}
			labels: {}
			traits: {}
		},
		{
			id:        "panel-keys"
			role:      "database-init"
			lifecycle: "one-shot"
			image:     _images["panel-keys"]
			entrypoint: ["/bin/sh"]
			command: ["/stackkit/keys.sh"]
			dependsOn: ["panel-bootstrap"]
			environment: {
				PGDATABASE: "panel"
				PGHOST: "panel-database"
				PGUSER: "panel"
			}
			secretEnvironment: {}
			volumes: [
				{id: "stackkit", target: "/stackkit", class: "cache"},
			]
			networks: ["game-internal"]
			health: {kind: "completion"}
			labels: {}
			traits: {}
		},
