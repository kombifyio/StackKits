			entrypoint: ["/bin/sh"]
			command: ["/stackkit/node.sh"]
			dependsOn: ["panel-keys"]
			environment: {}
			secretEnvironment: {}
			volumes: [
				{id: "stackkit", target: "/stackkit", class: "cache"},
				{id: "data", target: "/stackkit/game-data", class: "persistent", backup: true},
