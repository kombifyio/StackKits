// Package guacamole — Apache Guacamole module (scaffolded, draft).
//
// Immutable Guacamole and guacd image catalog. The executable native-v2 Remote workload owns explicit connection and node-custodied owner authentication; this legacy scaffold is not an unattended installer.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package guacamole

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "guacamole"
		displayName: "Apache Guacamole"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Immutable Guacamole and guacd image catalog. The executable native-v2 Remote workload owns explicit connection and node-custodied owner authentication; this legacy scaffold is not an unattended installer."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: false
		minMemory:         "512m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: {
		guacd: foundation.#ServiceDefinition & {
			name:     "guacd"
			type:     "application"
			image:    "docker.io/guacamole/guacd"
			tag:      "1.6.0@sha256:8974eaa9ba32f713daf311e7cc8cd7e4cdfba1edea39eed75524e78ef4b08f4f"
			required: false
			status:   "implemented"

			network: networks: ["guacamole-internal"]

			upstream: {
				github: repo: "apache/guacamole-server"
				registry: image: "guacamole/guacd"
				track: "minor"
			}

			healthCheck: {
				enabled:  true
				command:  "nc -z 127.0.0.1 4822"
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Apache Guacamole application (internal)"
		}
		guacamole: foundation.#ServiceDefinition & {
			name:     "guacamole"
			type:     "application"
			image:    "docker.io/guacamole/guacamole"
			tag:      "1.6.0@sha256:f344085e618bb05e22b964b0208dbd06d3468275bac70206f93805245e067b40"
			required: false
			status:   "implemented"
			needs: ["guacd"]

			network: {
				traefik: {
					enabled: true
					rule:    "Host(`remote.{{.domain}}`)"
					port:    8080
				}
				networks: ["guacamole-internal"]
			}

			accessPolicy: {
				outerAuth: "tinyauth-pocketid"
				appAuth:   "self-auth"
			}

			upstream: {
				github: repo: "apache/guacamole-client"
				registry: image: "guacamole/guacamole"
				track: "minor"
			}

			environment: {
				GUACAMOLE_HOME: "/dev/shm/stackkits-guacamole"
				GUACD_HOSTNAME: "guacd"
				GUACD_PORT:     "4822"
				WEBAPP_CONTEXT: "ROOT"
			}

			healthCheck: {
				enabled: true
				http: {
					path:   "/"
					port:   8080
					scheme: "http"
				}
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Apache Guacamole dashboard"
		}
	}
}
