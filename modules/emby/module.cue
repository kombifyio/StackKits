// Package emby — Emby module (scaffolded, draft).
//
// Emby media server with native TV and mobile apps. Closed source; some client features need an Emby Premiere licence.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package emby

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "emby"
		displayName: "Emby"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Emby media server with native TV and mobile apps. Closed source; some client features need an Emby Premiere licence."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "1g"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	presentation: {
		guideUrl: "https://docs.kombify.io/guides/stackkits/use-cases/media"
		clients: [{
			platform: "android"
			kind:     "store"
			url:      "https://play.google.com/store/apps/details?id=com.mb.android"
		}, {
			platform: "ios"
			kind:     "store"
			url:      "https://apps.apple.com/us/app/emby/id992180193"
		}]
		vendor: {
			name:    "Emby"
			website: "https://emby.media"
		}
	}

	services: emby: foundation.#ServiceDefinition & {
		name:     "emby"
		type:     "application"
		image:    "docker.io/emby/embyserver"
		tag:      "4.10.0.40"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`media.{{.domain}}`)"
				port:    8096
			}
			networks: ["media-internal"]
		}

		accessPolicy: {
			outerAuth:      "tinyauth-pocketid"
			appAuth:        "self-auth"
			ownerBootstrap: "Emby has no OIDC login: TinyAuth forward-auth (Pocket ID) guards the web app; Emby users stay app-local."
		}

		upstream: {
			github: repo:    "MediaBrowser/Emby.Releases"
			registry: image: "emby/embyserver"
			track: "minor"
		}

		volumes: [
			{
				source: "emby-config"
				target: "/config"
				type:   "volume"
				backup: true
			},
		]

		healthCheck: {
			enabled: true
			http: {
				path:   "/emby/System/Ping"
				port:   8096
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "512m"
			memoryMax: "4g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Emby dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of emby (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-emby-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-emby-runtime"
	workloadRef:    "media"
	alternativeRef: "emby"
	release:        "4.10.0.40"
	entryComponent: "emby"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "media"
		targetPort:        8096
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "emby-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {}
	backup: {
		volumes: [
			{componentRef: "emby", volumeRef: "config"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"emby-internal": {}
	}
	components: [
		{
			id:        "emby"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["emby"]
			environment: {}
			secretEnvironment: {}
			volumes: [
				{id: "config", target: "/config", class: "persistent", backup: true},
				{id: "library", target: "/media", class: "persistent", readOnly: true},
			]
			networks: ["emby-internal"]
			health: {kind: "http", path: "/emby/System/Ping", port: 8096}
			resources: {memoryLimit: "2g", memoryReservation: "512m"}
			labels: {}
			traits: {}
		},
	]
}
