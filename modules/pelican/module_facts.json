{
  "facts_schema_version": "1.0.0",
  "slug": "pelican",
  "displayName": "Pelican Panel",
  "description": "Pelican Panel and Wings upstream catalog (upstream beta), a Game platform alternative. The native-v2 game workload owns executable configuration, owner bootstrap and the governed Wings lifecycle-owner approval (ADR-0043, ADR-0048).",
  "layer": "L3-application",
  "rationale": "Game alternative to Calagopus (ADR-0048).",
  "requires": {
    "infrastructure": {
      "docker": true,
      "persistentStorage": true,
      "minMemory": "768m"
    }
  },
  "services": [
    {
      "name": "panel",
      "type": "application",
      "required": false,
      "imageSource": {
        "moduleRef": "stackkits-pelican-runtime",
        "componentRef": "panel"
      },
      "networks": [
        "game-internal"
      ],
      "volumes": [
        {
          "source": "pelican-data",
          "target": "/pelican-data",
          "type": "volume",
          "backup": true
        }
      ],
      "healthCheck": {
        "type": "http",
        "path": "/up",
        "port": 80
      },
      "resources": {
        "memory": "256m",
        "memoryMax": "1g"
      },
      "upstream": {
        "github": "pelican-dev/panel",
        "registryImage": "ghcr.io/pelican/panel"
      },
      "routed": true,
      "traefik": {
        "rule": "Host(`game.{{.domain}}`)",
        "port": 80
      },
      "accessPolicy": {
        "outerAuth": "self",
        "appAuth": "self-auth"
      }
    },
    {
      "name": "wings",
      "type": "application",
      "required": false,
      "imageSource": {
        "moduleRef": "stackkits-pelican-runtime",
        "componentRef": "wings"
      },
      "networks": [
        "game-internal"
      ],
      "volumes": [
        {
          "source": "wings-data",
          "target": "/stackkit/game-data",
          "type": "volume",
          "backup": true
        }
      ],
      "healthCheck": {
        "type": "http",
        "path": "/api/system",
        "port": 8080
      },
      "resources": {
        "memory": "128m",
        "memoryMax": "512m"
      },
      "upstream": {
        "github": "pelican-dev/wings",
        "registryImage": "ghcr.io/pelican/wings"
      }
    }
  ]
}
