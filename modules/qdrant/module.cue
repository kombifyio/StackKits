//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package qdrant

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "qdrant"
		displayName: "Qdrant"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Qdrant vector store for the chat module's knowledge base on the private AI network: collections persist in a backed-up volume, every request needs the API key from owner custody, no egress and no route."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "256m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: qdrant: foundation.#ServiceDefinition & {
		name:     "qdrant"
		type:     "application"
		image:    "docker.io/qdrant/qdrant"
		tag:      "v1.20.0@sha256:9bfc89f9914fc14876a88c05270685921a55b8877b254a98bcc1cc2f0a424cd2"
		required: false
		status:   "implemented"

		network: networks: ["private-ai-internal"]

		upstream: {
			github: repo: "qdrant/qdrant"
			registry: image: "docker.io/qdrant/qdrant"
			track: "minor"
		}

		volumes: [
			{
				source: "qdrant-storage"
				target: "/qdrant/storage"
				type:   "volume"
				backup: true
			},
		]

		healthCheck: {
			enabled: true
			http: {
				path:   "/healthz"
				port:   6333
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "256m"
			memoryMax: "2g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Qdrant application (internal)"
	}
}

