{
  "facts_schema_version": "1.0.0",
  "slug": "gitea",
  "displayName": "Gitea",
  "description": "Gitea image and storage catalog. Executable owner bootstrap is the native-v2 dev workload; this legacy scaffold is not an unattended installer.",
  "layer": "L3-application",
  "requires": {
    "infrastructure": {
      "docker": true,
      "persistentStorage": true,
      "minMemory": "256m"
    }
  },
  "services": [
    {
      "name": "gitea",
      "type": "application",
      "required": false,
      "imageSource": {
        "moduleRef": "stackkits-gitea-runtime",
        "componentRef": "gitea"
      },
      "networks": [
        "gitea-internal"
      ],
      "volumes": [
        {
          "source": "gitea-data",
          "target": "/var/lib/gitea",
          "type": "volume",
          "backup": true
        },
        {
          "source": "gitea-config",
          "target": "/etc/gitea",
          "type": "volume",
          "backup": true
        }
      ],
      "healthCheck": {
        "type": "http",
        "path": "/api/healthz",
        "port": 3000
      },
      "resources": {
        "memory": "256m",
        "memoryMax": "2g"
      },
      "upstream": {
        "github": "go-gitea/gitea",
        "registryImage": "docker.gitea.com/gitea"
      },
      "environment": {
        "GITEA__security__INSTALL_LOCK": "true",
        "GITEA__service__DISABLE_REGISTRATION": "true",
        "GITEA__service__REQUIRE_SIGNIN_VIEW": "true",
        "GITEA__repository__FORCE_PRIVATE": "true",
        "GITEA__server__DISABLE_SSH": "true",
        "GITEA__actions__ENABLED": "false"
      },
      "routed": true,
      "traefik": {
        "rule": "Host(`dev.{{.domain}}`)",
        "port": 3000
      },
      "accessPolicy": {
        "outerAuth": "self",
        "appAuth": "self-auth"
      }
    }
  ]
}
