// Package gitea — Gitea module (scaffolded, draft).
//
// Gitea image and storage catalog. Executable owner bootstrap is the native-v2 dev workload; this legacy scaffold is not an unattended installer.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package gitea

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "gitea"
		displayName: "Gitea"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Gitea image and storage catalog. Executable owner bootstrap is the native-v2 dev workload; this legacy scaffold is not an unattended installer."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "256m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	presentation: {
		guideUrl: "https://docs.kombify.io/stackkits/apps/gitea"
		vendor: {
			name:    "Gitea"
			website: "https://gitea.com"
			docs:    "https://docs.gitea.com"
			license: "MIT"
		}
	}

	services: gitea: foundation.#ServiceDefinition & {
		name:     "gitea"
		type:     "application"
		image:    "docker.gitea.com/gitea"
		tag:      "1.27.3-rootless@sha256:1c17ecaead42eb3b5391553d8708103a4beb0e86edf5b9ebc1eb269c318845f2"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`dev.{{.domain}}`)"
				port:    3000
			}
			networks: ["gitea-internal"]
		}

		accessPolicy: {
			outerAuth: "self"
			appAuth:   "self-auth"
		}

		upstream: {
			github: repo: "go-gitea/gitea"
			registry: image: "docker.gitea.com/gitea"
			track: "minor"
		}

		volumes: [
			{
				source: "gitea-data"
				target: "/var/lib/gitea"
				type:   "volume"
				backup: true
			},
			{
				source: "gitea-config"
				target: "/etc/gitea"
				type:   "volume"
				backup: true
			},
		]

		environment: {
			GITEA__actions__ENABLED:              "false"
			GITEA__repository__FORCE_PRIVATE:     "true"
			GITEA__security__INSTALL_LOCK:        "true"
			GITEA__server__DISABLE_SSH:           "true"
			GITEA__service__DISABLE_REGISTRATION: "true"
			GITEA__service__REQUIRE_SIGNIN_VIEW:  "true"
		}

		healthCheck: {
			enabled: true
			http: {
				path:   "/api/healthz"
				port:   3000
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "256m"
			memoryMax: "2g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Gitea dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of gitea (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-gitea-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-gitea-runtime"
	workloadRef:    "dev"
	alternativeRef: "gitea"
	release:        "1.27.3-rootless"
	entryComponent: "gitea"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "git"
		targetPort:        3000
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "gitea-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {}
	backup: {
		volumes: [
			{componentRef: "gitea", volumeRef: "data"},
			{componentRef: "gitea", volumeRef: "config"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"gitea-internal": {}
	}
	components: [
		{
			id:        "gitea"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["gitea"]
			command: ["/bin/sh", "-ec", "gitea -c \"$GITEA_APP_INI\" migrate && users=$(gitea -c \"$GITEA_APP_INI\" admin user list) && owner=$(printf '%s\\n' \"$users\" | awk '$1 ~ /^[0-9]+$/ && $2 == \"owner\" {print $3 \" \" $4 \" \" $5}') && if [ -n \"$owner\" ]; then [ \"$owner\" = \"$STACKKITS_OWNER_EMAIL true true\" ] || { echo 'Existing Gitea owner does not match local custody' >&2; exit 1; }; else count=$(printf '%s\\n' \"$users\" | awk '$1 ~ /^[0-9]+$/ {n++} END {print n+0}'); [ \"$count\" = 0 ] || { echo 'Existing Gitea users require explicit owner reconciliation' >&2; exit 1; }; password=$(cat \"$STACKKITS_OWNER_PASSWORD_FILE\"); gitea -c \"$GITEA_APP_INI\" admin user create --username owner --email \"$STACKKITS_OWNER_EMAIL\" --password \"$password\" --admin --must-change-password=false; fi && exec gitea -c \"$GITEA_APP_INI\" web"]
			environment: {
				GITEA__actions__ENABLED: "false"
				GITEA__database__DB_TYPE: "sqlite3"
				GITEA__database__PATH: "/var/lib/gitea/data/gitea.db"
				GITEA__repository__DEFAULT_PRIVATE: "private"
				GITEA__repository__FORCE_PRIVATE: "true"
				GITEA__security__INSTALL_LOCK: "true"
				GITEA__security__REVERSE_PROXY_LIMIT: "0"
				GITEA__server__DISABLE_SSH: "true"
				GITEA__service__DISABLE_REGISTRATION: "true"
				GITEA__service__REQUIRE_SIGNIN_VIEW: "true"
			}
			secretEnvironment: {}
			volumes: [
				{id: "data", target: "/var/lib/gitea", class: "persistent", backup: true},
				{id: "config", target: "/etc/gitea", class: "persistent", backup: true},
			]
			networks: ["gitea-internal"]
			health: {kind: "http", path: "/api/healthz", port: 3000}
			resources: {memoryLimit: "2g", memoryReservation: "256m"}
			labels: {}
			traits: {}
		},
	]
}
