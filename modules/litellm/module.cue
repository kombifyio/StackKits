// Package litellm — LiteLLM module (scaffolded, draft).
//
// LiteLLM model router without a database: one OpenAI-compatible endpoint for the node's Ollama models, guarded by the master key from owner custody; admin UI off, no egress, local or remote-private route only.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package litellm

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "litellm"
		displayName: "LiteLLM"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "LiteLLM model router without a database: one OpenAI-compatible endpoint for the node's Ollama models, guarded by the master key from owner custody; admin UI off, no egress, local or remote-private route only."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: false
		minMemory:         "512m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: litellm: foundation.#ServiceDefinition & {
		name:     "litellm"
		type:     "application"
		image:    "ghcr.io/berriai/litellm"
		tag:      "v1.105.0@sha256:60947db020b57e204823d3fbc8bb295c85be890d7c9adcc77fb4f5fc2fe410b2"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`ai-gateway.{{.domain}}`)"
				port:    4000
			}
			networks: ["private-ai-internal"]
		}

		accessPolicy: {
			outerAuth: "self"
			appAuth:   "self-auth"
			reason:    "Apps and devices cannot complete the kit's browser login, so LiteLLM's master key guards every model route; the route is never public."
		}

		upstream: {
			github: repo: "BerriAI/litellm"
			registry: image: "ghcr.io/berriai/litellm"
			track: "minor"
		}

		healthCheck: {
			enabled: true
			http: {
				path:   "/health/liveliness"
				port:   4000
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "512m"
			memoryMax: "2g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "LiteLLM dashboard"
	}
}
