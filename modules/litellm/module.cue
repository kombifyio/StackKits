// Package litellm — LiteLLM module (scaffolded, draft).
//
// LiteLLM model router without a database: one OpenAI-compatible endpoint for the node's Ollama models, guarded by the master key from owner custody; admin UI off, no egress, local or remote-private route only.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package litellm

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "litellm"
		displayName: "LiteLLM"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "LiteLLM model router without a database: one OpenAI-compatible endpoint for the node's Ollama models, guarded by the master key from owner custody; admin UI off, no egress, local or remote-private route only."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: false
		minMemory:         "512m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: litellm: foundation.#ServiceDefinition & {
		name:     "litellm"
		type:     "application"
		image:    "ghcr.io/berriai/litellm"
		tag:      "v1.105.0@sha256:60947db020b57e204823d3fbc8bb295c85be890d7c9adcc77fb4f5fc2fe410b2"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`ai-gateway.{{.domain}}`)"
				port:    4000
			}
			networks: ["private-ai-internal"]
		}

		accessPolicy: {
			outerAuth: "self"
			appAuth:   "self-auth"
			reason:    "Apps and devices cannot complete the kit's browser login, so LiteLLM's master key guards every model route; the route is never public."
		}

		upstream: {
			github: repo: "BerriAI/litellm"
			registry: image: "ghcr.io/berriai/litellm"
			track: "minor"
		}

		healthCheck: {
			enabled: true
			http: {
				path:   "/health/liveliness"
				port:   4000
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "512m"
			memoryMax: "2g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "LiteLLM dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of litellm (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-litellm-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-litellm-runtime"
	workloadRef:    "ai"
	alternativeRef: "litellm"
	release:        "v1.105.0"
	entryComponent: "litellm"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	secrets: {
		"master-key": purpose: "Custody secret slot master-key for litellm"
	}
	networks: {
		"litellm-internal": {}
	}
	components: [
		{
			id:        "litellm"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["litellm"]
			entrypoint: ["/bin/sh", "-ec", "mkdir -p /etc/litellm && printf 'model_list:\\n  - model_name: \"ollama/*\"\\n    litellm_params:\\n      model: \"ollama_chat/*\"\\n      api_base: \"http://ollama:11434\"\\nlitellm_settings:\\n  drop_params: true\\n  check_provider_endpoint: true\\ngeneral_settings:\\n  master_key: os.environ/LITELLM_MASTER_KEY\\n' > /etc/litellm/config.yaml && exec /app/docker/prod_entrypoint.sh --config /etc/litellm/config.yaml --port 4000"]
			environment: {
				DISABLE_ADMIN_UI: "True"
				LITELLM_LOCAL_MODEL_COST_MAP: "True"
				LITELLM_LOG: "INFO"
			}
			secretEnvironment: {
				LITELLM_MASTER_KEY: "master-key"
			}
			networks: ["litellm-internal"]
			health: {kind: "http", path: "/health/liveliness", port: 4000}
			resources: {memoryLimit: "2g", memoryReservation: "512m"}
			labels: {}
			traits: {}
		},
	]
}
