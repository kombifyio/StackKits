@@ -0,0 +1,63 @@
+package controller
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/pocket-id/pocket-id/backend/internal/dto"
+	"github.com/pocket-id/pocket-id/backend/internal/membership"
+	"net/http"
+	"strconv"
+)
+
+func membershipCondition(c *gin.Context, target string) (*membership.Condition, error) {
+	if err := membership.ValidateHeader(c.Request.Header); err != nil {
+		return nil, err
+	}
+	mode := c.Request.Header.Values("X-PocketID-Membership-Mode")
+	if len(mode) > 1 || (len(mode) == 1 && mode[0] != "required") {
+		return nil, membership.Fail(400)
+	}
+	ctx, condition := membership.WithCondition(c.Request.Context(), target, c.GetHeader("If-Match"))
+	condition.Require = len(mode) == 1
+	if condition.Require && condition.ETag == "" {
+		return nil, membership.Fail(428)
+	}
+	c.Request = c.Request.WithContext(ctx)
+	return condition, nil
+}
+func membershipHeaders(c *gin.Context, tag string) {
+	c.Header(membership.Header, membership.Contract)
+	c.Header("ETag", tag)
+	c.Header("Cache-Control", "no-store")
+}
+func (uc *UserController) membershipSnapshot(c *gin.Context) error {
+	u, tag, required, err := uc.userService.MembershipSnapshot(c.Request.Context(), c.Param("id"))
+	if err != nil {
+		return err
+	}
+	var out dto.UserDto
+	if err = dto.MapStruct(u, &out); err != nil {
+		return err
+	}
+	membershipHeaders(c, tag)
+	c.Header("X-PocketID-Membership-Required", strconv.FormatBool(required))
+	c.JSON(http.StatusOK, out)
+	return nil
+}
+func (uc *UserController) membershipCapability(c *gin.Context) error {
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, gin.H{"contract": membership.Contract})
+	return nil
+}
+func (gc *UserGroupController) membershipSnapshot(c *gin.Context) error {
+	g, tag, err := gc.UserGroupService.MembershipSnapshot(c.Request.Context(), c.Param("id"))
+	if err != nil {
+		return err
+	}
+	var out dto.UserGroupDto
+	if err = dto.MapStruct(g, &out); err != nil {
+		return err
+	}
+	membershipHeaders(c, tag)
+	c.JSON(http.StatusOK, out)
+	return nil
+}
