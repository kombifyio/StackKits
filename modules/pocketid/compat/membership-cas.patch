diff --git a/backend/internal/membership/fence.go b/backend/internal/membership/fence.go
--- a/backend/internal/membership/fence.go
+++ b/backend/internal/membership/fence.go
@@ -0,0 +1,171 @@
+// Package membership implements the downstream pocketid-membership-cas-v1 contract.
+// All callers use the provider's existing transaction and admin authorization.
+package membership
+
+import (
+	"context"
+	"fmt"
+	"github.com/pocket-id/pocket-id/backend/internal/apperror"
+	"github.com/pocket-id/pocket-id/backend/internal/common"
+	"gorm.io/gorm"
+	"math"
+	"net/http"
+	"slices"
+)
+
+const Contract = "pocketid-membership-cas-v1"
+const Header = "X-PocketID-Membership-Contract"
+
+type requestKey struct{}
+type Condition struct {
+	Target, ETag, Result string
+	Require              bool
+}
+
+func WithCondition(ctx context.Context, target, etag string) (context.Context, *Condition) {
+	c := &Condition{Target: target, ETag: etag}
+	return context.WithValue(ctx, requestKey{}, c), c
+}
+func Fail(status int) error {
+	return apperror.New("membership_precondition", status, "Membership changed or requires a conditional write; reload and retry")
+}
+
+// Lock serializes membership effects across processes, on PostgreSQL AND SQLite.
+// It is also used for coherent multi-query snapshots. No process-local mutex is relied on.
+func Lock(ctx context.Context, tx *gorm.DB) error {
+	q := tx.WithContext(ctx).Exec("UPDATE membership_clock SET revision = revision WHERE id = 1")
+	if q.Error != nil {
+		return q.Error
+	}
+	if q.RowsAffected != 1 {
+		return Fail(503)
+	}
+	return nil
+}
+func epoch(ctx context.Context, tx *gorm.DB) (int64, error) {
+	var n int64
+	err := tx.WithContext(ctx).Raw("SELECT revision FROM membership_clock WHERE id = 1").Scan(&n).Error
+	return n, err
+}
+func Tag(target string, n int64) string { return fmt.Sprintf("\"pid-membership-v1:%s:%d\"", target, n) }
+
+type State struct {
+	Revision            int64
+	ConditionalRequired bool
+}
+
+func Read(ctx context.Context, tx *gorm.DB, id string) (State, error) {
+	var n int64
+	if err := tx.WithContext(ctx).Table("users").Where("id = ?", id).Count(&n).Error; err != nil {
+		return State{}, err
+	}
+	if n != 1 {
+		return State{}, apperror.UserNotFound()
+	}
+	var s State
+	err := tx.WithContext(ctx).Table("membership_versions").Where("user_id = ?", id).Scan(&s).Error
+	return s, err
+}
+func GroupTag(ctx context.Context, tx *gorm.DB, id string) (string, error) {
+	n, e := epoch(ctx, tx)
+	return Tag("group:"+id, n), e
+}
+
+// Change must run after Lock and BEFORE associations/deletion. The parent
+// transaction rolls back the versions together with every failed effect.
+func Change(ctx context.Context, tx *gorm.DB, ids []string, group string) error {
+	ids = slices.Clone(ids)
+	slices.Sort(ids)
+	ids = slices.Compact(ids)
+	n, err := epoch(ctx, tx)
+	if err != nil {
+		return err
+	}
+	if n == math.MaxInt64 {
+		return Fail(503)
+	}
+	c, _ := ctx.Value(requestKey{}).(*Condition)
+	matched := false
+	if group != "" && c != nil && c.ETag != "" {
+		if c.Target != "group:"+group || c.ETag != Tag(c.Target, n) {
+			return Fail(412)
+		}
+		matched = true
+	}
+	for _, id := range ids {
+		s, e := Read(ctx, tx, id)
+		if e != nil {
+			return e
+		}
+		conditional := matched
+		if group == "" && c != nil && c.ETag != "" {
+			if len(ids) != 1 || c.Target != "user:"+id || c.ETag != Tag(c.Target, s.Revision) {
+				return Fail(412)
+			}
+			conditional = true
+		}
+		if s.ConditionalRequired && !conditional {
+			return Fail(428)
+		}
+		if s.Revision == math.MaxInt64 {
+			return Fail(503)
+		}
+		// A managed user must remain local. LDAP is not a second writer authority.
+		activate := conditional && group == "" && c != nil && c.Require
+		if activate {
+			if id == common.StaticApiKeyUserID {
+				return Fail(409)
+			}
+			var ldap int64
+			if e = tx.WithContext(ctx).Table("users").Where("id = ? AND ldap_id IS NOT NULL", id).Count(&ldap).Error; e != nil {
+				return e
+			}
+			if ldap != 0 {
+				return Fail(409)
+			}
+		}
+		e = tx.WithContext(ctx).Exec(`INSERT INTO membership_versions (user_id, revision, conditional_required) VALUES (?, ?, ?)
+    ON CONFLICT (user_id) DO UPDATE SET revision = excluded.revision, conditional_required = excluded.conditional_required`, id, s.Revision+1, s.ConditionalRequired || activate).Error
+		if e != nil {
+			return e
+		}
+		if c != nil && group == "" {
+			c.Result = Tag("user:"+id, s.Revision+1)
+		}
+	}
+	if err = tx.WithContext(ctx).Exec("UPDATE membership_clock SET revision = revision + 1 WHERE id = 1").Error; err != nil {
+		return err
+	}
+	if c != nil && group != "" {
+		c.Result = Tag("group:"+group, n+1)
+	}
+	return nil
+}
+func GroupMembers(ctx context.Context, tx *gorm.DB, group string) ([]string, error) {
+	var ids []string
+	err := tx.WithContext(ctx).Table("user_groups_users").Where("user_group_id = ?", group).Pluck("user_id", &ids).Error
+	return ids, err
+}
+func DeleteGroup(ctx context.Context, tx *gorm.DB, group string) error {
+	if err := Lock(ctx, tx); err != nil {
+		return err
+	}
+	ids, e := GroupMembers(ctx, tx, group)
+	if e != nil {
+		return e
+	}
+	return Change(ctx, tx, ids, group)
+}
+
+// ValidateHeader refuses duplicate, weak and wildcard conditions. Equality to
+// the exact target/version is checked under the database lock, not here.
+func ValidateHeader(h http.Header) error {
+	v := h.Values("If-Match")
+	if len(v) > 1 {
+		return Fail(400)
+	}
+	if len(v) == 1 && (len(v[0]) > 180 || len(v[0]) < 2 || v[0][0] != '"' || v[0][len(v[0])-1] != '"') {
+		return Fail(400)
+	}
+	return nil
+}
diff --git a/backend/internal/service/membership_protocol_test.go b/backend/internal/service/membership_protocol_test.go
--- a/backend/internal/service/membership_protocol_test.go
+++ b/backend/internal/service/membership_protocol_test.go
@@ -0,0 +1,188 @@
+//go:build unit
+
+package service
+
+import (
+	"context"
+	"errors"
+	sqlitekit "github.com/italypaleale/go-sql-utils/sqlite"
+	"github.com/libtnb/sqlite"
+	"github.com/pocket-id/pocket-id/backend/internal/appconfig"
+	"github.com/pocket-id/pocket-id/backend/internal/apperror"
+	"github.com/pocket-id/pocket-id/backend/internal/dto"
+	"github.com/pocket-id/pocket-id/backend/internal/membership"
+	"github.com/pocket-id/pocket-id/backend/internal/model"
+	"github.com/pocket-id/pocket-id/backend/internal/utils"
+	"gorm.io/gorm"
+	"log/slog"
+	"path/filepath"
+	"testing"
+)
+
+// Sensitive authorization/migration protocol boundary. Uses PocketID's real
+// file-backed SQLite configuration and embedded production migrations. No HTTP
+// provider mock, in-memory DB, business-flow unit suite or standing server.
+func TestMembershipCASProtocol(t *testing.T) {
+	ctx := context.Background()
+	dsn, _, _, _, err := sqlitekit.ParseConnectionString(filepath.Join(t.TempDir(), "pocketid.db"), slog.Default())
+	must := func(e error) {
+		t.Helper()
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+	must(err)
+	db, err := gorm.Open(sqlite.Open(dsn), &gorm.Config{})
+	must(err)
+	sqlDB, err := db.DB()
+	must(err)
+	defer sqlDB.Close()
+	must(utils.MigrateDatabase(ctx, sqlDB))
+	// A second independent connection pool exercises the database fence.
+	db2, err := gorm.Open(sqlite.Open(dsn), &gorm.Config{})
+	must(err)
+	sql2, err := db2.DB()
+	must(err)
+	defer sql2.Close()
+	u := model.User{Username: "cas-protocol", FirstName: "CAS"}
+	must(db.Create(&u).Error)
+	group := model.UserGroup{Name: "cas-group", FriendlyName: "CAS group"}
+	must(db.Create(&group).Error)
+	us := &UserService{db: db}
+	other := &UserService{db: db2}
+	gs := &UserGroupService{db: db}
+	status := func(e error, n int) {
+		t.Helper()
+		var app *apperror.Error
+		if !errors.As(e, &app) || app.HTTPStatus() != n {
+			t.Fatalf("wanted %d, got %v", n, e)
+		}
+	}
+	put := func(s *UserService, tag string, groups []string) error {
+		c, condition := membership.WithCondition(ctx, "user:"+u.ID, tag)
+		condition.Require = true
+		_, e := s.UpdateUserGroups(c, u.ID, groups)
+		return e
+	}
+	_, old, _, err := us.MembershipSnapshot(ctx, u.ID)
+	must(err)
+	// Newer no-op revoke must still fence the delayed old grant.
+	must(put(other, old, []string{}))
+	status(put(us, old, []string{group.ID}), 412)
+	current, tag, required, err := us.MembershipSnapshot(ctx, u.ID)
+	must(err)
+	if len(current.UserGroups) != 0 || !required || tag == old {
+		t.Fatal("no-op did not establish sticky fence")
+	}
+	_, err = us.UpdateUserGroups(ctx, u.ID, []string{group.ID})
+	status(err, 428)
+	// Lost successful grant response, new service instance, then latest revoke.
+	must(put(us, tag, []string{group.ID}))
+	_, next, _, err := other.MembershipSnapshot(ctx, u.ID)
+	must(err)
+	must(put(other, next, []string{}))
+	status(put(us, tag, []string{group.ID}), 412)
+	// Inverse path cannot bypass a managed user's fence. Existing owner operation
+	// remains available with a coherent group snapshot and the same admin authority.
+	_, err = gs.UpdateUsers(ctx, group.ID, []string{u.ID})
+	status(err, 428)
+	_, groupTag, err := gs.MembershipSnapshot(ctx, group.ID)
+	must(err)
+	c, _ := membership.WithCondition(ctx, "group:"+group.ID, groupTag)
+	_, err = gs.UpdateUsers(c, group.ID, []string{u.ID})
+	must(err)
+	status(put(us, next, []string{}), 412)
+	status(gs.Delete(ctx, &appconfig.AppConfigModel{}, group.ID), 428)
+	_, groupTag, err = gs.MembershipSnapshot(ctx, group.ID)
+	must(err)
+	c, _ = membership.WithCondition(ctx, "group:"+group.ID, groupTag)
+	must(gs.Delete(c, &appconfig.AppConfigModel{}, group.ID))
+	current, tag, _, err = us.MembershipSnapshot(ctx, u.ID)
+	must(err)
+	if len(current.UserGroups) != 0 {
+		t.Fatal("group delete did not remove membership")
+	}
+	// Delete shares the fence; old user Save cannot resurrect this incarnation.
+	c, _ = membership.WithCondition(ctx, "user:"+u.ID, tag)
+	must(db.Transaction(func(tx *gorm.DB) error { return us.DeleteUserInternal(c, &appconfig.AppConfigModel{}, tx, u.ID, false) }))
+	status(put(other, tag, []string{}), 404)
+	var n int64
+	must(db.Model(&model.User{}).Where("id = ?", u.ID).Count(&n).Error)
+	if n != 0 {
+		t.Fatal("deleted UUID resurrected")
+	}
+	// Unmanaged compatibility still accepts legacy writes.
+	legacy := model.User{Username: "cas-legacy", FirstName: "Legacy"}
+	must(db.Create(&legacy).Error)
+	_, err = us.UpdateUserGroups(ctx, legacy.ID, []string{})
+	must(err)
+	_, _, required, err = us.MembershipSnapshot(ctx, legacy.ID)
+	must(err)
+	if required {
+		t.Fatal("legacy call activated managed mode")
+	}
+	// Both owner form directions retain their original snapshot condition.
+	// A newer revoke must reject the old full-set selection, including no-op saves.
+	_, userFormTag, _, err := us.MembershipSnapshot(ctx, legacy.ID)
+	must(err)
+	formGroup := model.UserGroup{Name: "form-group", FriendlyName: "Form"}
+	must(db.Create(&formGroup).Error)
+	_, groupFormTag, err := gs.MembershipSnapshot(ctx, formGroup.ID)
+	must(err)
+	uc, _ := membership.WithCondition(ctx, "user:"+legacy.ID, userFormTag)
+	_, err = us.UpdateUserGroups(uc, legacy.ID, []string{})
+	must(err)
+	uc, _ = membership.WithCondition(ctx, "user:"+legacy.ID, userFormTag)
+	_, err = us.UpdateUserGroups(uc, legacy.ID, []string{formGroup.ID})
+	status(err, 412)
+	gc, _ := membership.WithCondition(ctx, "group:"+formGroup.ID, groupFormTag)
+	_, err = gs.UpdateUsers(gc, formGroup.ID, []string{legacy.ID})
+	status(err, 412)
+	_, groupFormTag, err = gs.MembershipSnapshot(ctx, formGroup.ID)
+	must(err)
+	gc, accepted := membership.WithCondition(ctx, "group:"+formGroup.ID, groupFormTag)
+	_, err = gs.UpdateUsers(gc, formGroup.ID, []string{legacy.ID})
+	must(err)
+	if accepted.Result == "" || accepted.Result == groupFormTag {
+		t.Fatal("accepted group write did not yield the next form condition")
+	}
+	gc, _ = membership.WithCondition(ctx, "group:"+formGroup.ID, accepted.Result)
+	_, err = gs.UpdateUsers(gc, formGroup.ID, []string{})
+	must(err)
+
+	// Exercise the real GORM zero-row UPDATE seam deterministically. This local
+	// DB callback removes the row after the service read, immediately before SQL
+	// UPDATE. Old Save resurrects it; update-only must return 404 and never INSERT.
+	profile := model.UserGroup{Name: "profile-delete-race", FriendlyName: "Original"}
+	must(db.Create(&profile).Error)
+	armed := true
+	must(db.Callback().Update().Before("gorm:update").Register("protocol:remove-before-profile-write", func(tx *gorm.DB) {
+		if armed && tx.Statement.Table == "user_groups" {
+			armed = false
+			tx.AddError(tx.Session(&gorm.Session{NewDB: true}).Exec("DELETE FROM user_groups WHERE id = ?", profile.ID).Error)
+		}
+	}))
+	_, err = gs.Update(ctx, &appconfig.AppConfigModel{}, profile.ID, dto.UserGroupCreateDto{Name: profile.Name, FriendlyName: "Delayed"})
+	status(err, 404)
+	if armed {
+		t.Fatal("profile zero-row update seam was not exercised")
+	}
+	must(db.Callback().Update().Remove("protocol:remove-before-profile-write"))
+	// The failed transaction rolled back; a normal profile edit remains usable.
+	updatedProfile, err := gs.Update(ctx, &appconfig.AppConfigModel{}, profile.ID, dto.UserGroupCreateDto{Name: profile.Name, FriendlyName: "Accepted"})
+	must(err)
+	if updatedProfile.FriendlyName != "Accepted" {
+		t.Fatal("profile edit lost")
+	}
+	_, profileTag, err := gs.MembershipSnapshot(ctx, profile.ID)
+	must(err)
+	gc, _ = membership.WithCondition(ctx, "group:"+profile.ID, profileTag)
+	must(gs.Delete(gc, &appconfig.AppConfigModel{}, profile.ID))
+	_, err = gs.Update(ctx, &appconfig.AppConfigModel{}, profile.ID, dto.UserGroupCreateDto{Name: profile.Name, FriendlyName: "Late"})
+	status(err, 404)
+	must(db.Model(&model.UserGroup{}).Where("id = ?", profile.ID).Count(&n).Error)
+	if n != 0 {
+		t.Fatal("profile writer resurrected deleted group UUID")
+	}
+
+}
