// Package paperclip — Paperclip module (scaffolded, draft).
//
// Paperclip agent control plane (org chart of agents, budgets, approvals, tasks) with its own PostgreSQL in one gVisor-isolated bundle; no host Docker socket, no egress, no provider key, private route behind the kit login and Paperclip's own login.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package paperclip

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "paperclip"
		displayName: "Paperclip"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Paperclip agent control plane (org chart of agents, budgets, approvals, tasks) with its own PostgreSQL in one gVisor-isolated bundle; no host Docker socket, no egress, no provider key, private route behind the kit login and Paperclip's own login."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "512m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: paperclip: foundation.#ServiceDefinition & {
		name:     "paperclip"
		type:     "application"
		image:    "ghcr.io/paperclipai/paperclip"
		tag:      "2026.916.1@sha256:a02ac35ac41df911af477422ea0e781cf41d2b2c600c66f0a5ac9d8c63f52c2c"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`ai-control-plane.{{.domain}}`)"
				port:    3100
			}
			networks: ["private-ai-internal"]
		}

		accessPolicy: {
			outerAuth: "tinyauth-pocketid"
			appAuth:   "self-auth"
			reason:    "Paperclip runs in authenticated mode (Better Auth); the first sign-up behind the gateway login becomes the instance admin."
		}

		upstream: {
			github: repo: "paperclipai/paperclip"
			registry: image: "ghcr.io/paperclipai/paperclip"
			track: "minor"
		}

		environment: {
			HOST:                          "0.0.0.0"
			PAPERCLIP_DEPLOYMENT_EXPOSURE: "private"
			PAPERCLIP_DEPLOYMENT_MODE:     "authenticated"
			PAPERCLIP_HOME:                "/paperclip"
			PORT:                          "3100"
			SERVE_UI:                      "true"
		}

		healthCheck: {
			enabled: true
			http: {
				path:   "/api/health"
				port:   3100
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "512m"
			memoryMax: "4g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Paperclip dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of paperclip (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-paperclip-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-paperclip-runtime"
	workloadRef:    "ai"
	alternativeRef: "paperclip"
	release:        "2026.916.1"
	entryComponent: "paperclip"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "paperclip"
		targetPort:        3100
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "paperclip-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {
		"database-password": purpose: "Custody secret slot database-password for paperclip"
	}
	backup: {
		volumes: [
			{componentRef: "paperclip", volumeRef: "home"},
			{componentRef: "paperclip-postgres", volumeRef: "database"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"paperclip-internal": {}
	}
	components: [
		{
			id:        "paperclip"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["paperclip"]
			entrypoint: ["/bin/sh", "-ec", "export DATABASE_URL=\"$(node -e 'const u = new URL(\"postgres://paperclip@paperclip-postgres:5432/paperclip\"); u.password = require(\"fs\").readFileSync(process.env.STACKKIT_PAPERCLIP_DB_PASSWORD_FILE, \"utf8\"); process.stdout.write(u.href);')\"; export BETTER_AUTH_SECRET=\"$(cat \"$STACKKIT_SESSION_SECRET_FILE\")\"; unset STACKKIT_PAPERCLIP_DB_PASSWORD_FILE STACKKIT_SESSION_SECRET_FILE; exec /usr/bin/tini -- docker-entrypoint.sh node --import ./server/node_modules/tsx/dist/loader.mjs server/dist/index.js"]
			dependsOn: ["paperclip-postgres"]
			environment: {
				HOST: "0.0.0.0"
				PAPERCLIP_DEPLOYMENT_EXPOSURE: "private"
				PAPERCLIP_DEPLOYMENT_MODE: "authenticated"
				PAPERCLIP_HIDDEN_SETTINGS: "instance.general.feedbackDataSharingPreference"
				PAPERCLIP_HOME: "/paperclip"
				PAPERCLIP_INSTANCE_ID: "default"
				PAPERCLIP_SETTING_DEFAULTS: "{\"feedbackDataSharingPreference\":\"not_allowed\"}"
				PORT: "3100"
				SERVE_UI: "true"
			}
			secretEnvironment: {}
			volumes: [
				{id: "home", target: "/paperclip", class: "persistent", backup: true},
			]
			networks: ["paperclip-internal"]
			health: {kind: "http", path: "/api/health", port: 3100}
			resources: {memoryLimit: "4g", memoryReservation: "512m", cpus: 2}
			labels: {}
			traits: {
				sandboxRuntime: {runtime: "runsc"}
			}
		},
		{
			id:        "paperclip-postgres"
			role:      "database"
			lifecycle: "daemon"
			image:     _images["paperclip-postgres"]
			environment: {
				POSTGRES_DB: "paperclip"
				POSTGRES_USER: "paperclip"
			}
			secretEnvironment: {
				POSTGRES_PASSWORD: "database-password"
			}
			volumes: [
				{id: "database", target: "/var/lib/postgresql/data", class: "persistent", backup: true},
			]
			networks: ["paperclip-internal"]
			health: {kind: "command", command: ["pg_isready", "-U", "paperclip", "-d", "paperclip"]}
			resources: {memoryLimit: "1g", memoryReservation: "256m"}
			labels: {}
			traits: {}
		},
	]
}
