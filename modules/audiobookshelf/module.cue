// Package audiobookshelf — Audiobookshelf module (scaffolded, draft).
//
// Audiobook and podcast server with mobile apps and progress sync.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package audiobookshelf

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "audiobookshelf"
		displayName: "Audiobookshelf"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Audiobook and podcast server with mobile apps and progress sync."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "128m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	presentation: {
		guideUrl: "https://docs.kombify.io/guides/stackkits/use-cases/media"
		clients: [{
			platform: "android"
			kind:     "store"
			url:      "https://play.google.com/store/apps/details?id=com.audiobookshelf.app"
		}]
		vendor: {
			name:    "Audiobookshelf"
			website: "https://www.audiobookshelf.org"
			docs:    "https://www.audiobookshelf.org/docs/documentation/introduction"
			license: "GPL-3.0"
		}
	}

	services: audiobookshelf: foundation.#ServiceDefinition & {
		name:     "audiobookshelf"
		type:     "application"
		image:    "ghcr.io/advplyr/audiobookshelf"
		tag:      "2.36.1"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`audiobooks.{{.domain}}`)"
				port:    80
			}
			networks: ["media-internal"]
		}

		accessPolicy: {
			outerAuth:      "self"
			appAuth:        "oidc-sso"
			ownerBootstrap: "Register Audiobookshelf as an OIDC client in Pocket ID and set issuer https://id.{{.domain}} under Settings > Authentication > OpenID Connect."
		}

		upstream: {
			github: repo:    "advplyr/audiobookshelf"
			registry: image: "ghcr.io/advplyr/audiobookshelf"
			track: "minor"
		}

		volumes: [
			{
				source: "audiobookshelf-config"
				target: "/config"
				type:   "volume"
				backup: true
			},
			{
				source: "audiobookshelf-metadata"
				target: "/metadata"
				type:   "volume"
				backup: true
			},
		]

		healthCheck: {
			enabled: true
			http: {
				path:   "/healthcheck"
				port:   80
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "128m"
			memoryMax: "1g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Audiobookshelf dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of audiobookshelf (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-audiobookshelf-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-audiobookshelf-runtime"
	workloadRef:    "media"
	alternativeRef: "audiobookshelf"
	release:        "2.36.1"
	entryComponent: "audiobookshelf"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "audiobooks"
		targetPort:        80
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "audiobookshelf-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {}
	backup: {
		volumes: [
			{componentRef: "audiobookshelf", volumeRef: "config"},
			{componentRef: "audiobookshelf", volumeRef: "metadata"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"audiobookshelf-internal": {}
	}
	components: [
		{
			id:        "audiobookshelf"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["audiobookshelf"]
			environment: {}
			secretEnvironment: {}
			volumes: [
				{id: "config", target: "/config", class: "persistent", backup: true},
				{id: "metadata", target: "/metadata", class: "persistent", backup: true},
				{id: "library", target: "/audiobooks", class: "persistent", readOnly: true},
			]
			networks: ["audiobookshelf-internal"]
			health: {kind: "http", path: "/healthcheck", port: 80}
			resources: {memoryLimit: "1g", memoryReservation: "128m"}
			labels: {}
			traits: {
				homeIdentityAccess: {caBundleTarget: "/etc/stackkit/ca-bundle.pem", caBundleEnvironment: ["NODE_EXTRA_CA_CERTS"]}
				pocketIDClient: {
					callbackURLs: ["{{origin}}/auth/openid/callback", "{{origin}}/auth/openid/mobile-redirect"]
					environment: {
						ROUTER_BASE_PATH: ""
					}
				}
			}
		},
	]
}
