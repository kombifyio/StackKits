// Package forgejo — Forgejo module (scaffolded, draft).
//
// Forgejo community Git forge (Gitea fork) with pull requests, issues, packages and Actions.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package forgejo

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "forgejo"
		displayName: "Forgejo"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Forgejo community Git forge (Gitea fork) with pull requests, issues, packages and Actions."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "256m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	presentation: {
		guideUrl: "https://docs.kombify.io/guides/stackkits/use-cases/development"
		vendor: {
			name:    "Forgejo"
			website: "https://forgejo.org"
			docs:    "https://forgejo.org/docs/latest/"
			license: "GPL-3.0"
		}
	}

	services: forgejo: foundation.#ServiceDefinition & {
		name:     "forgejo"
		type:     "application"
		image:    "codeberg.org/forgejo/forgejo"
		tag:      "16.0.5"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`dev.{{.domain}}`)"
				port:    3000
			}
			networks: ["dev-internal"]
		}

		accessPolicy: {
			outerAuth:      "self"
			appAuth:        "oidc-sso"
			ownerBootstrap: "Register Forgejo as an OIDC client in Pocket ID, then add it with forgejo admin auth add-oauth --provider openidConnect --auto-discover-url https://id.{{.domain}}/.well-known/openid-configuration."
		}

		upstream: {
			github: repo:    "forgejo/forgejo"
			registry: image: "codeberg.org/forgejo/forgejo"
			track: "minor"
		}

		volumes: [
			{
				source: "forgejo-data"
				target: "/data"
				type:   "volume"
				backup: true
			},
		]

		environment: {
			FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION:   "true"
			FORGEJO__security__INSTALL_LOCK:                    "true"
			FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION: "true"
			FORGEJO__service__REQUIRE_SIGNIN_VIEW:              "true"
		}

		healthCheck: {
			enabled: true
			http: {
				path:   "/api/healthz"
				port:   3000
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "256m"
			memoryMax: "2g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Forgejo dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of forgejo (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-forgejo-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-forgejo-runtime"
	workloadRef:    "dev"
	alternativeRef: "forgejo"
	release:        "16.0.5-rootless"
	entryComponent: "forgejo"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "git"
		targetPort:        3000
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "forgejo-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {}
	backup: {
		volumes: [
			{componentRef: "forgejo", volumeRef: "data"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"forgejo-internal": {}
	}
	components: [
		{
			id:        "forgejo"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["forgejo"]
			command: ["/bin/sh", "-ec", "forgejo migrate && users=$(forgejo admin user list) && owner=$(printf '%s\\n' \"$users\" | awk '$1 ~ /^[0-9]+$/ && $2 == \"owner\" {print $3 \" \" $4 \" \" $5}') && if [ -n \"$owner\" ]; then [ \"$owner\" = \"$STACKKITS_OWNER_EMAIL true true\" ] || { echo 'Existing Forgejo owner does not match local custody' >&2; exit 1; }; else count=$(printf '%s\\n' \"$users\" | awk '$1 ~ /^[0-9]+$/ {n++} END {print n+0}'); [ \"$count\" = 0 ] || { echo 'Existing Forgejo users require explicit owner reconciliation' >&2; exit 1; }; password=$(cat \"$STACKKITS_OWNER_PASSWORD_FILE\"); forgejo admin user create --username owner --email \"$STACKKITS_OWNER_EMAIL\" --password \"$password\" --admin --must-change-password=false; fi && exec forgejo web"]
			environment: {
				FORGEJO__actions__ENABLED: "false"
				FORGEJO__database__DB_TYPE: "sqlite3"
				FORGEJO__database__PATH: "/var/lib/gitea/data/forgejo.db"
				FORGEJO__repository__DEFAULT_PRIVATE: "private"
				FORGEJO__repository__FORCE_PRIVATE: "true"
				FORGEJO__security__INSTALL_LOCK: "true"
				FORGEJO__security__REVERSE_PROXY_LIMIT: "0"
				FORGEJO__server__DISABLE_SSH: "true"
				FORGEJO__service__DISABLE_REGISTRATION: "true"
				FORGEJO__service__REQUIRE_SIGNIN_VIEW: "true"
			}
			secretEnvironment: {}
			volumes: [
				{id: "data", target: "/var/lib/gitea", class: "persistent", backup: true},
			]
			networks: ["forgejo-internal"]
			health: {kind: "http", path: "/api/healthz", port: 3000}
			resources: {memoryLimit: "2g", memoryReservation: "256m"}
			labels: {}
			traits: {}
		},
	]
}
