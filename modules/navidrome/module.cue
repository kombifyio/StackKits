// Package navidrome — Navidrome module (scaffolded, draft).
//
// Music server and streamer compatible with Subsonic clients.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package navidrome

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "navidrome"
		displayName: "Navidrome"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Music server and streamer compatible with Subsonic clients."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "128m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	presentation: {
		guideUrl: "https://docs.kombify.io/guides/stackkits/use-cases/media"
		vendor: {
			name:    "Navidrome"
			website: "https://www.navidrome.org"
			docs:    "https://www.navidrome.org/docs"
			license: "GPL-3.0"
		}
	}

	services: navidrome: foundation.#ServiceDefinition & {
		name:     "navidrome"
		type:     "application"
		image:    "docker.io/deluan/navidrome"
		tag:      "0.64.2"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`music.{{.domain}}`)"
				port:    4533
			}
			networks: ["media-internal"]
		}

		accessPolicy: {
			outerAuth:      "tinyauth-pocketid"
			appAuth:        "self-auth"
			ownerBootstrap: "TinyAuth forward-auth (Pocket ID); Navidrome can map the forwarded user through ND_REVERSEPROXYUSERHEADER."
		}

		upstream: {
			github: repo:    "navidrome/navidrome"
			registry: image: "deluan/navidrome"
			track: "minor"
		}

		volumes: [
			{
				source: "navidrome-data"
				target: "/data"
				type:   "volume"
				backup: true
			},
		]

		healthCheck: {
			enabled: true
			http: {
				path:   "/ping"
				port:   4533
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "128m"
			memoryMax: "512m"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Navidrome dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of navidrome (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-navidrome-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-navidrome-runtime"
	workloadRef:    "media"
	alternativeRef: "navidrome"
	release:        "0.64.2"
	entryComponent: "navidrome"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "music"
		targetPort:        4533
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "navidrome-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {}
	backup: {
		volumes: [
			{componentRef: "navidrome", volumeRef: "data"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"navidrome-internal": {}
	}
	components: [
		{
			id:        "navidrome"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["navidrome"]
			environment: {
				ND_DATAFOLDER: "/data"
				ND_MUSICFOLDER: "/music"
			}
			secretEnvironment: {}
			volumes: [
				{id: "data", target: "/data", class: "persistent", backup: true},
				{id: "library", target: "/music", class: "persistent", readOnly: true},
			]
			networks: ["navidrome-internal"]
			health: {kind: "http", path: "/ping", port: 4533}
			resources: {memoryLimit: "512m", memoryReservation: "128m"}
			labels: {}
			traits: {}
		},
	]
}
