// Package euro_office — Euro-Office module (scaffolded, draft).
//
// Euro-Office Document Server (ONLYOFFICE fork) for editing documents, spreadsheets and presentations in the browser; connects to Nextcloud through the eurooffice-nextcloud app.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package euro_office

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "euro-office"
		displayName: "Euro-Office"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Euro-Office Document Server (ONLYOFFICE fork) for editing documents, spreadsheets and presentations in the browser; connects to Nextcloud through the eurooffice-nextcloud app."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "2g"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	presentation: {
		guideUrl: "https://docs.kombify.io/guides/stackkits/use-cases/documents-and-files"
		vendor: {
			name:    "Euro-Office"
			docs:    "https://euro-office.github.io/documentation/"
			license: "AGPL-3.0"
		}
	}

	services: documentserver: foundation.#ServiceDefinition & {
		name:     "documentserver"
		type:     "application"
		image:    "ghcr.io/euro-office/documentserver"
		tag:      "v9.3.4-hotfix.1"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`office.{{.domain}}`)"
				port:    80
			}
			networks: ["files-internal"]
		}

		accessPolicy: {
			outerAuth: "self"
			appAuth:   "none"
			reason:    "Document Server has no user login; every request must carry a JWT signed with the custodied secret shared with the Nextcloud connector, so Nextcloud can call it server-side."
		}

		upstream: {
			github: repo:    "Euro-Office/DocumentServer"
			registry: image: "ghcr.io/euro-office/documentserver"
			track: "minor"
		}

		volumes: [
			{
				source: "euro-office-data"
				target: "/var/www/onlyoffice/Data"
				type:   "volume"
				backup: true
			},
			{
				source: "euro-office-logs"
				target: "/var/log/onlyoffice"
				type:   "volume"
				backup: false
			},
		]

		healthCheck: {
			enabled: true
			http: {
				path:   "/healthcheck"
				port:   80
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "2g"
			memoryMax: "4g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "Euro-Office dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of euro-office (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-euro-office-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-euro-office-runtime"
	workloadRef:    "documents"
	alternativeRef: "euro-office"
	release:        "v9.3.4-hotfix.1"
	entryComponent: "euro-office"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "office"
		targetPort:        80
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "euro-office-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {
		"jwt-secret": purpose: "Custody secret slot jwt-secret for euro-office"
	}
	backup: {
		volumes: [
			{componentRef: "euro-office", volumeRef: "data"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"euro-office-internal": {}
	}
	components: [
		{
			id:        "euro-office"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["euro-office"]
			environment: {
				JWT_ENABLED: "true"
			}
			secretEnvironment: {
				JWT_SECRET: "jwt-secret"
			}
			volumes: [
				{id: "data", target: "/var/www/euro-office/Data", class: "persistent", backup: true},
			]
			networks: ["euro-office-internal"]
			health: {kind: "http", path: "/healthcheck", port: 80}
			resources: {memoryLimit: "4g", memoryReservation: "2g"}
			labels: {}
			traits: {}
		},
	]
}
