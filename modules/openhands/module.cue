// Package openhands — OpenHands module (scaffolded, draft).
//
// OpenHands Agent Canvas task and coding agent in one gVisor-isolated container with its own workspace; no host Docker socket, the node's Ollama as model endpoint, private route behind the kit login.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package openhands

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "openhands"
		displayName: "OpenHands"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "OpenHands Agent Canvas task and coding agent in one gVisor-isolated container with its own workspace; no host Docker socket, the node's Ollama as model endpoint, private route behind the kit login."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "1g"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	services: openhands: foundation.#ServiceDefinition & {
		name:     "openhands"
		type:     "application"
		image:    "ghcr.io/openhands/agent-canvas"
		tag:      "1.24.0@sha256:ad0829a7082a71ddfd2d16c1fae5a2172e4ca5a34eba7f03b69bd5b9b1bc54d7"
		required: false
		status:   "implemented"

		network: {
			traefik: {
				enabled: true
				rule:    "Host(`ai-harness.{{.domain}}`)"
				port:    8000
			}
			networks: ["private-ai-internal"]
		}

		accessPolicy: {
			outerAuth: "tinyauth-pocketid"
			appAuth:   "none"
			reason:    "OpenHands signs its own browser session in with the container's session key, so only the gateway login protects the private route."
		}

		upstream: {
			github: repo: "OpenHands/OpenHands"
			registry: image: "ghcr.io/openhands/agent-canvas"
			track: "minor"
		}

		environment: {
			DO_NOT_TRACK:      "1"
			VITE_DO_NOT_TRACK: "1"
		}

		healthCheck: {
			enabled: true
			http: {
				path:   "/alive"
				port:   8000
				scheme: "http"
			}
			interval: "30s"
			timeout:  "10s"
			retries:  3
		}

		resources: {
			memory:    "1g"
			memoryMax: "6g"
		}

		security: {
			noNewPrivileges: true
			capDrop: ["ALL"]
		}

		output: description: "OpenHands dashboard"
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of openhands (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-openhands-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-openhands-runtime"
	workloadRef:    "ai"
	alternativeRef: "openhands"
	release:        "1.24.0"
	entryComponent: "openhands"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "openhands"
		targetPort:        8000
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "openhands-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {}
	backup: {
		volumes: [
			{componentRef: "openhands", volumeRef: "settings"},
			{componentRef: "openhands", volumeRef: "workspace"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"openhands-internal": {}
	}
	components: [
		{
			id:        "openhands"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["openhands"]
			entrypoint: ["/bin/sh", "-ec", "s=/home/openhands/.openhands/settings.json; if [ ! -e \"$s\" ]; then printf '%s\\n' \"$STACKKIT_OPENHANDS_SETTINGS_SEED\" > \"$s\"; chmod 600 \"$s\"; fi; unset STACKKIT_OPENHANDS_SETTINGS_SEED; exec tini -- /opt/agent-canvas/entrypoint.sh"]
			environment: {
				DO_NOT_TRACK: "1"
				STACKKIT_OPENHANDS_SETTINGS_SEED: "{\"schema_version\":3,\"agent_settings\":{\"schema_version\":6,\"agent_kind\":\"openhands\",\"llm\":{\"model\":\"ollama_chat/qwen3.5:9b\",\"base_url\":\"http://ollama:11434\"}}}"
				VITE_DO_NOT_TRACK: "1"
			}
			secretEnvironment: {}
			volumes: [
				{id: "settings", target: "/home/openhands/.openhands", class: "persistent", backup: true},
				{id: "workspace", target: "/projects", class: "persistent", backup: true},
			]
			networks: ["openhands-internal"]
			egress: true
			health: {kind: "http", path: "/alive", port: 8000}
			resources: {memoryLimit: "6g", memoryReservation: "1g", cpus: 2}
			labels: {}
			traits: {
				sandboxRuntime: {runtime: "runsc"}
			}
		},
	]
}
