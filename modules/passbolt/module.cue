// Package passbolt — Passbolt CE module (scaffolded, draft).
//
// Passbolt Community Edition: team password manager with end-to-end encryption and browser extensions, backed by MariaDB.
//
// Generated by `stackkit module scaffold` from module_facts.json (ADR-0027).
// Deterministic output: edit the facts and re-scaffold; do not hand-diff.
package passbolt

import "github.com/kombifyio/stackkits/foundation"

Contract: foundation.#ModuleContract & {
	metadata: {
		name:        "passbolt"
		displayName: "Passbolt CE"
		version:     "0.1.0"
		layer:       "L3-application"
		description: "Passbolt Community Edition: team password manager with end-to-end encryption and browser extensions, backed by MariaDB."
		core:        false
		maturity:    "draft"
	}

	requires: infrastructure: {
		docker:            true
		dockerSocket:      false
		persistentStorage: true
		minMemory:         "512m"
	}

	placementSupport: {
		local_only:         true
		standard:           true
		managed_serverless: false
	}

	presentation: {
		guideUrl: "https://docs.kombify.io/guides/stackkits/use-cases/vault"
		clients: [{
			platform: "android"
			kind:     "store"
			url:      "https://play.google.com/store/apps/details?id=com.passbolt.mobile.android"
		}, {
			platform: "ios"
			kind:     "store"
			url:      "https://apps.apple.com/app/id1569629432"
		}, {
			platform: "windows"
			kind:     "store"
			url:      "https://apps.microsoft.com/detail/9pfxs2wvkvpb"
		}]
		vendor: {
			name:    "Passbolt"
			website: "https://www.passbolt.com"
			docs:    "https://help.passbolt.com"
			license: "AGPL-3.0"
		}
	}

	services: {
		passbolt: foundation.#ServiceDefinition & {
			name:     "passbolt"
			type:     "application"
			image:    "docker.io/passbolt/passbolt"
			tag:      "5.16.0-1-ce"
			required: false
			status:   "implemented"

			network: {
				traefik: {
					enabled: true
					rule:    "Host(`vault.{{.domain}}`)"
					port:    80
				}
				networks: ["vault-internal"]
			}

			accessPolicy: {
				outerAuth:      "tinyauth-pocketid"
				appAuth:        "self-auth"
				ownerBootstrap: "Passbolt CE has no SSO (SSO is a Passbolt Pro feature): TinyAuth forward-auth (Pocket ID) guards the web app; Passbolt accounts keep their own keys."
			}

			upstream: {
				github: repo:    "passbolt/passbolt_api"
				registry: image: "passbolt/passbolt"
				track: "minor"
			}

			volumes: [
				{
					source: "passbolt-gpg"
					target: "/etc/passbolt/gpg"
					type:   "volume"
					backup: true
				},
				{
					source: "passbolt-jwt"
					target: "/etc/passbolt/jwt"
					type:   "volume"
					backup: true
				},
			]

			healthCheck: {
				enabled: true
				http: {
					path:   "/healthcheck/status.json"
					port:   80
					scheme: "http"
				}
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			resources: {
				memory:    "256m"
				memoryMax: "1g"
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Passbolt CE dashboard"
		}
		mariadb: foundation.#ServiceDefinition & {
			name:     "mariadb"
			type:     "database"
			image:    "docker.io/library/mariadb"
			tag:      "11.8.3"
			required: false
			status:   "implemented"

			network: networks: ["vault-internal"]

			upstream: {
				github: repo:    "MariaDB/server"
				registry: image: "mariadb"
				track: "minor"
			}

			volumes: [
				{
					source: "passbolt-db"
					target: "/var/lib/mysql"
					type:   "volume"
					backup: true
				},
			]

			healthCheck: {
				enabled:  true
				command:  "healthcheck.sh --connect --innodb_initialized"
				interval: "30s"
				timeout:  "10s"
				retries:  3
			}

			resources: {
				memory:    "256m"
				memoryMax: "1g"
			}

			security: {
				noNewPrivileges: true
				capDrop: ["ALL"]
			}

			output: description: "Passbolt CE database (internal)"
		}
	}
}

// AppModuleV3 is the #AppModuleV3 declaration of passbolt (ADR-0055 Phase 2A).
AppModuleV3: foundation.#AppModuleV3 & {
	let _images = foundation.AppModuleV3CatalogImages["stackkits-passbolt-runtime"]
	apiVersion:     "stackkit.app-module/v3"
	moduleRef:      "stackkits-passbolt-runtime"
	workloadRef:    "vault"
	alternativeRef: "passbolt"
	release:        "5.16.0-1-ce-non-root"
	entryComponent: "passbolt"
	delivery: {contract: "opentofu-stage1", resourcePrefix: "workload"}
	lifecycle: {}
	route: {
		serviceRef:        "vault"
		targetPort:        8080
		upstreamProtocol:  "http"
		ingressAuth:       "forward-auth"
		healthRef:         "passbolt-http"
		requiredPrivilege: "user"
		allowedExposures: ["local", "remote-private", "public"]
	}
	secrets: {
		"database-password": purpose: "Custody secret slot database-password for passbolt"
		"database-root-password": purpose: "Custody secret slot database-root-password for passbolt"
	}
	backup: {
		volumes: [
			{componentRef: "passbolt", volumeRef: "gpg"},
			{componentRef: "passbolt", volumeRef: "jwt"},
			{componentRef: "passbolt-mariadb", volumeRef: "database"},
		]
		hookRef:  "hook/quiesce-stop"
		probeRef: "probe/http-status"
	}
	networks: {
		"passbolt-internal": {}
	}
	components: [
		{
			id:        "passbolt"
			role:      "application"
			lifecycle: "daemon"
			image:     _images["passbolt"]
			command: ["/usr/bin/wait-for.sh", "-t", "0", "passbolt-mariadb:3306", "--", "/docker-entrypoint.sh"]
			dependsOn: ["passbolt-mariadb"]
			environment: {
				DATASOURCES_DEFAULT_DATABASE: "passbolt"
				DATASOURCES_DEFAULT_HOST: "passbolt-mariadb"
				DATASOURCES_DEFAULT_USERNAME: "passbolt"
				PASSBOLT_REGISTRATION_PUBLIC: "false"
				PASSBOLT_SSL_FORCE: "false"
			}
			secretEnvironment: {
				DATASOURCES_DEFAULT_PASSWORD: "database-password"
			}
			volumes: [
				{id: "gpg", target: "/etc/passbolt/gpg", class: "persistent", backup: true},
				{id: "jwt", target: "/etc/passbolt/jwt", class: "persistent", backup: true},
			]
			networks: ["passbolt-internal"]
			health: {kind: "http", path: "/healthcheck/status.json", port: 8080}
			resources: {memoryLimit: "1g", memoryReservation: "256m"}
			labels: {}
			traits: {}
		},
		{
			id:        "passbolt-mariadb"
			role:      "database"
			lifecycle: "daemon"
			image:     _images["passbolt-mariadb"]
			environment: {
				MARIADB_DATABASE: "passbolt"
				MARIADB_USER: "passbolt"
			}
			secretEnvironment: {
				MARIADB_PASSWORD: "database-password"
				MARIADB_ROOT_PASSWORD: "database-root-password"
			}
			volumes: [
				{id: "database", target: "/var/lib/mysql", class: "persistent", backup: true},
			]
			networks: ["passbolt-internal"]
			health: {kind: "command", command: ["healthcheck.sh", "--connect", "--innodb_initialized"]}
			resources: {memoryLimit: "1g", memoryReservation: "256m"}
			labels: {}
			traits: {}
		},
	]
}
