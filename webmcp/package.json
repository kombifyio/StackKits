{
  "name": "@kombifyio/stackkits-webmcp",
  "version": "0.1.0",
  "description": "StackKits WebMCP v2alpha1 planner, contracts, and public reference host",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "files": [
    "dist",
    "assets",
    "data",
    "schemas",
    "src",
    "scripts",
    "reference-host/src",
    "reference-host/scripts",
    "reference-host/package.json",
    "reference-host/package-lock.json",
    "reference-host/vite.config.ts",
    "reference-host/svelte.config.js",
    "reference-host/tsconfig.json",
    "reference-host/index.html",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./planner": {
      "types": "./src/planner.ts",
      "import": "./src/planner.ts",
      "default": "./src/planner.ts"
    },
    "./webmcp": {
      "types": "./src/webmcp.ts",
      "import": "./src/webmcp.ts",
      "default": "./src/webmcp.ts"
    },
    "./StackKitsPlanner.svelte": "./src/StackKitsPlanner.svelte",
    "./StackKitsPlannerHost.svelte": "./src/StackKitsPlannerHost.svelte",
    "./schemas/*": "./schemas/*",
    "./assets/*": "./assets/*",
    "./data/*": "./data/*",
    "./generator": {
      "types": "./src/generator.ts",
      "import": "./dist/generator.js",
      "default": "./dist/generator.js"
    }
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "build:capacity": "node scripts/build-capacity-wasm.mjs",
    "prepack": "npm run build",
    "build": "npm run build:capacity && npm run generate:types && tsc -p tsconfig.json",
    "generate:catalog": "npm run build && node scripts/generate-catalog.mjs",
    "check": "npm run build"
  },
  "dependencies": {
    "webmcp-types": "0.1.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "svelte": ">=5.57.1"
  }
}
