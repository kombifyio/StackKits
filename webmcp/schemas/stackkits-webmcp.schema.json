{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackkit.cc/schemas/stackkits-webmcp-v1.schema.json",
  "title": "StackKits WebMCP v1",
  "description": "Closed, read-only StackKits planner tools and their common result envelope.",
  "$defs": {
    "schemaVersion": { "const": "stackkits-webmcp/v1" },
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha64": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stackkitId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "description": "Public StackKit identifier; it is never inferred."
    },
    "computeTier": {
      "type": "string",
      "enum": ["low", "standard", "high"],
      "description": "Explicit product graph selection."
    },
    "useCaseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "description": "A CUE-declared use-case identifier."
    },
    "toolName": {
      "type": "string",
      "enum": [
        "stackkits_list_catalog",
        "stackkits_get_tier_profile",
        "stackkits_assess_capacity",
        "stackkits_prepare_handoff"
      ]
    },
    "outcome": { "type": "string", "enum": ["success", "invalid_input", "blocked"] },
    "capacityStatus": { "type": "string", "enum": ["fail", "warning", "pass", "unverified"] },
    "capacityReasonCode": {
      "type": "string",
      "enum": [
        "DECLARED_CAPACITY_BELOW_MINIMUM",
        "DECLARED_CAPACITY_BELOW_RECOMMENDATION",
        "DECLARED_CAPACITY_INCOMPLETE",
        "DECLARED_REQUIREMENT_NOT_DECLARED",
        "DECLARED_CAPACITY_PASS"
      ]
    },
    "partialDeclaredCapacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores": { "type": "integer", "minimum": 1, "description": "User-declared available CPU cores." },
        "ram_gb": { "type": "number", "exclusiveMinimum": 0, "description": "User-declared available RAM in GiB." },
        "storage_gb": { "type": "number", "exclusiveMinimum": 0, "description": "User-declared free storage in GiB." }
      }
    },
    "declaredCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_cores", "ram_gb", "storage_gb"],
      "properties": {
        "cpu_cores": { "type": "integer", "minimum": 1, "description": "User-declared available CPU cores." },
        "ram_gb": { "type": "number", "exclusiveMinimum": 0, "description": "User-declared available RAM in GiB." },
        "storage_gb": { "type": "number", "exclusiveMinimum": 0, "description": "User-declared free storage in GiB." }
      }
    },
    "authoringInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$",
          "description": "A required authoring-contract path, not a shell flag."
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 255, "description": "Explicit contract value." }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_base": {
          "type": "string",
          "pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)(?:\\.(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?))+$",
          "description": "Explicit network.domain.base DNS name."
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "description": "Explicit StackSpec metadata name."
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stackkit_id": { "$ref": "#/$defs/stackkitId" },
        "compute_tier": { "$ref": "#/$defs/computeTier" },
        "use_case_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/useCaseId" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "source_sha", "authority_bundle_sha256", "catalog_sha256"],
      "properties": {
        "authority": { "const": "cue" },
        "source_sha": { "$ref": "#/$defs/sha40" },
        "authority_bundle_sha256": { "$ref": "#/$defs/sha64" },
        "catalog_sha256": { "$ref": "#/$defs/sha64" }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "field": { "type": "string", "minLength": 1, "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "target_mutation", "provider_action"],
      "properties": {
        "executed": { "const": false },
        "target_mutation": { "const": false },
        "provider_action": { "const": false }
      }
    },
    "listCatalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stackkit_id", "display_name", "version", "status", "planner_link", "compute_tiers"],
      "properties": {
        "stackkit_id": { "$ref": "#/$defs/stackkitId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "minLength": 1, "maxLength": 80 },
        "planner_link": { "type": "string", "pattern": "^/planner\\?stackkit_id=[a-z][a-z0-9-]{0,62}$" },
        "compute_tiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/computeTier" } }
      }
    },
    "listCatalogData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kits", "selection_required"],
      "properties": {
        "kits": { "type": "array", "items": { "$ref": "#/$defs/listCatalogItem" } },
        "selection_required": { "const": true }
      }
    },
    "capacityTuple": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "description": "CPU cores, RAM GiB, and storage GiB in that order."
    },
    "optionalCapacityTuple": {
      "type": "array",
      "prefixItems": [
        { "type": ["number", "null"] }, { "type": ["number", "null"] }, { "type": ["number", "null"] }
      ],
      "items": false,
      "description": "CPU cores, RAM GiB, and storage GiB; null means not declared."
    },
    "runtimeRequirementTuple": {
      "type": "array",
      "prefixItems": [
        { "type": ["number", "null"] }, { "type": ["number", "null"] }, { "type": ["number", "null"] },
        { "type": ["number", "null"] }, { "type": ["number", "null"] }, { "type": ["number", "null"] }
      ],
      "items": false,
      "description": "Minimum CPU/RAM/storage followed by recommended CPU/RAM/storage; null means not declared."
    },
    "useCaseLoadTuple": {
      "type": "array",
      "prefixItems": [
        { "type": "string", "enum": ["always-on", "on-demand", "scheduled"] },
        { "type": "string", "enum": ["none", "idle-resident", "active-resident"] },
        { "type": "string", "enum": ["none", "interactive", "ingest", "batch"] }
      ],
      "items": false,
      "description": "Residency, baseline, and burst in that order."
    },
    "compactIncludedUseCase": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/useCaseId" },
        { "type": ["string", "null"], "maxLength": 128 },
        { "type": "array", "items": { "type": "string", "maxLength": 80 } },
        { "oneOf": [{ "$ref": "#/$defs/useCaseLoadTuple" }, { "type": "null" }] }
      ],
      "items": false,
      "description": "Use-case ID, module or alternative, functions, and load tuple. Full CUE notes and exclusion reasons remain in the visible planner."
    },
    "tierProfileData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "graph", "modules", "use_cases"],
      "properties": {
        "capacity": {
          "type": "object", "additionalProperties": false, "required": ["min", "recommended"],
          "properties": { "min": { "$ref": "#/$defs/capacityTuple" }, "recommended": { "$ref": "#/$defs/optionalCapacityTuple" } }
        },
        "graph": {
          "type": "object", "additionalProperties": false, "required": ["substitutions"],
          "properties": {
            "substitutions": {
              "type": "array",
              "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "items": false }
            },
            "capabilities": { "type": "array", "items": { "type": "string" } }
          }
        },
        "modules": {
          "type": "object", "additionalProperties": false, "required": ["declared", "undeclared"],
          "properties": {
            "declared": {
              "type": "array",
              "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/runtimeRequirementTuple" }], "items": false }
            },
            "undeclared": { "type": "array", "items": { "type": "string" } }
          }
        },
        "use_cases": {
          "type": "object", "additionalProperties": false, "required": ["included", "excluded"],
          "properties": {
            "included": { "type": "array", "items": { "$ref": "#/$defs/compactIncludedUseCase" } },
            "excluded": { "type": "array", "items": { "$ref": "#/$defs/useCaseId" } }
          }
        }
      }
    },
    "capacityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "status", "reason_code"],
      "properties": {
        "axis": { "type": "string", "enum": ["cpu_cores", "ram_gb", "storage_gb"] },
        "observed": { "type": "number" },
        "minimum": { "type": "number" },
        "recommended": { "type": "number" },
        "status": { "$ref": "#/$defs/capacityStatus" },
        "reason_code": { "$ref": "#/$defs/capacityReasonCode" }
      }
    },
    "capacityData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_capacity", "checks", "overall", "origin"],
      "properties": {
        "declared_capacity": { "$ref": "#/$defs/partialDeclaredCapacity" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/capacityCheck" } },
        "overall": { "$ref": "#/$defs/capacityStatus" },
        "origin": { "const": "user_declared" }
      }
    },
    "handoffStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "mutation", "idempotent", "owner_approval"],
      "properties": {
        "id": { "type": "string", "pattern": "^stackkit\\.(?:init|validate|resolve|generate|plan)$" },
        "argv": { "type": "array", "minItems": 2, "items": { "type": "string", "maxLength": 255 } },
        "mutation": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "owner_approval": { "type": "boolean" }
      }
    },
    "handoffFollowUp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mutation", "idempotent", "owner_approval", "executable"],
      "properties": {
        "id": { "const": "stackkit.apply" },
        "mutation": { "const": true },
        "idempotent": { "type": "boolean" },
        "owner_approval": { "const": true },
        "executable": { "const": false }
      }
    },
    "handoffData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "capacity_status", "steps", "apply_follow_up"],
      "properties": {
        "ready": { "type": "boolean" },
        "capacity_status": { "$ref": "#/$defs/capacityStatus" },
        "steps": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/handoffStep" } },
        "apply_follow_up": { "$ref": "#/$defs/handoffFollowUp" },
        "blocked_reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" } }
      }
    },
    "emptyData": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "outcome", "provenance", "data", "notices", "effects"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "tool": { "$ref": "#/$defs/toolName" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "selection": { "$ref": "#/$defs/selection" },
        "data": {},
        "notices": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
        "effects": { "$ref": "#/$defs/effects" }
      }
    }
  },
  "tools": {
    "stackkits_list_catalog": {
      "title": "List StackKits",
      "description": "List public StackKits and their declared compute tiers. Choose explicitly; this tool never recommends.",
      "input": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": { "$ref": "#/$defs/result" },
      "data": { "$ref": "#/$defs/listCatalogData" }
    },
    "stackkits_get_tier_profile": {
      "title": "Get tier profile",
      "description": "Read the selected StackKit compute-tier graph, capacity requirements, substitutions, modules, and use-case fits.",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["stackkit_id", "compute_tier"],
        "properties": {
          "stackkit_id": { "$ref": "#/$defs/stackkitId", "description": "Explicit public StackKit identifier." },
          "compute_tier": { "$ref": "#/$defs/computeTier", "description": "Explicit product graph; no default is applied." }
        }
      },
      "result": { "$ref": "#/$defs/result" },
      "data": { "$ref": "#/$defs/tierProfileData" }
    },
    "stackkits_assess_capacity": {
      "title": "Assess declared capacity",
      "description": "Compare user-declared CPU, RAM, and free storage with the selected tier's declared minimum and recommendation.",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["stackkit_id", "compute_tier", "declared_capacity"],
        "properties": {
          "stackkit_id": { "$ref": "#/$defs/stackkitId", "description": "Explicit public StackKit identifier." },
          "compute_tier": { "$ref": "#/$defs/computeTier", "description": "Explicit graph; inventory never selects it." },
          "declared_capacity": { "$ref": "#/$defs/partialDeclaredCapacity", "description": "Declared axes; missing axes stay unverified." }
        }
      },
      "result": { "$ref": "#/$defs/result" },
      "data": { "$ref": "#/$defs/capacityData" }
    },
    "stackkits_prepare_handoff": {
      "title": "Prepare StackKit handoff",
      "description": "Prepare a validated, non-executing CLI handoff for an explicit StackKit, tier, capacity, use cases, and authoring inputs.",
      "input": {
        "type": "object", "additionalProperties": false, "required": ["stackkit_id", "compute_tier", "declared_capacity"],
        "properties": {
          "stackkit_id": { "$ref": "#/$defs/stackkitId", "description": "Explicit public StackKit identifier." },
          "compute_tier": { "$ref": "#/$defs/computeTier", "description": "Explicit product graph; no default is applied." },
          "declared_capacity": { "$ref": "#/$defs/partialDeclaredCapacity", "description": "All axes are required by the handoff business rule." },
          "use_case_ids": {
            "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "$ref": "#/$defs/useCaseId" },
            "description": "Included use cases passed to stackkit init."
          },
          "authoring": { "$ref": "#/$defs/authoring", "description": "Known authoring-contract values." },
          "authoring_inputs": {
            "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "$ref": "#/$defs/authoringInput" },
            "description": "Additional required contract-path values."
          }
        }
      },
      "result": { "$ref": "#/$defs/result" },
      "data": { "$ref": "#/$defs/handoffData" }
    }
  }
}
