{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kombify.io/schemas/architecture-snapshot-2.3.0.json",
  "title": "kombify-StackKits architecture snapshot",
  "$comment": "Focused contract for the placement-eligibility (2.1.0), mode-matrix (2.2.0), and enriched stackkits/wizard_schema (2.3.0, additive) additions. Other emitted top-level fields (source, generated_at, architecture_patterns, wizard_schema, contexts, stackkits, service_groups) are intentionally not constrained here.",
  "type": "object",
  "required": ["schema_version", "placement_model", "mode_matrix", "modules", "addons"],
  "properties": {
    "schema_version": {"const": "2.3.0"},
    "mode_matrix": {
      "type": "object",
      "required": ["levels", "kits"],
      "properties": {
        "levels": {"type": "array", "items": {"enum": ["supported", "scaffolding", "unsupported", "control-plane"]}},
        "paas_statuses": {"type": "array", "items": {"enum": ["default", "supported", "draft", "experimental"]}},
        "note": {"type": "string"},
        "kits": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/kitModeSupport"}
        }
      }
    },
    "placement_model": {
      "type": "object",
      "required": ["axis", "modes", "oss_realized", "control_plane_only"],
      "properties": {
        "axis": {"const": "placementMode"},
        "modes": {
          "type": "array",
          "minItems": 3,
          "items": {"enum": ["local-only", "standard", "managed-serverless"]}
        },
        "oss_realized": {"type": "array", "items": {"type": "string"}},
        "control_plane_only": {"type": "array", "items": {"type": "string"}},
        "sub_dimensions": {"type": "object"},
        "note": {"type": "string"},
        "source_standard": {"type": "string"}
      }
    },
    "modules": {"type": "array", "items": {"$ref": "#/$defs/catalogEntry"}},
    "addons": {"type": "array", "items": {"$ref": "#/$defs/catalogEntry"}}
  },
  "$defs": {
    "kitModeSupport": {
      "type": "object",
      "required": ["kit", "placement", "install", "context"],
      "properties": {
        "kit": {"type": "string"},
        "placement": {
          "type": "object",
          "required": ["local-only", "standard", "managed-serverless"],
          "properties": {
            "local-only": {"$ref": "#/$defs/supportLevel"},
            "standard": {"$ref": "#/$defs/supportLevel"},
            "managed-serverless": {"const": "control-plane"}
          }
        },
        "install": {
          "type": "object",
          "required": ["bare", "bootstrapped", "advanced"],
          "additionalProperties": {"$ref": "#/$defs/supportLevel"}
        },
        "context": {
          "type": "object",
          "required": ["local", "cloud", "pi"],
          "additionalProperties": {"$ref": "#/$defs/supportLevel"}
        },
        "paas": {
          "type": "object",
          "additionalProperties": {"enum": ["default", "supported", "draft", "experimental"]}
        },
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "supportLevel": {"enum": ["supported", "scaffolding", "unsupported", "control-plane"]},
    "catalogEntry": {
      "type": "object",
      "required": ["slug", "source_path", "placement"],
      "properties": {
        "slug": {"type": "string"},
        "display_name": {"type": "string"},
        "layer": {"type": "string"},
        "description": {"type": "string"},
        "source_path": {"type": "string"},
        "placement": {"$ref": "#/$defs/placementEligibility"}
      }
    },
    "placementEligibility": {
      "type": "object",
      "required": ["supports", "cf_fit"],
      "properties": {
        "supports": {
          "type": "object",
          "required": ["local_only", "standard", "managed_serverless"],
          "properties": {
            "local_only": {"type": "boolean"},
            "standard": {"type": "boolean"},
            "managed_serverless": {"type": "boolean"}
          }
        },
        "cf_fit": {"type": "boolean"},
        "rejection_reason": {"type": ["string", "null"]}
      }
    }
  }
}
