{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kombify.io/schemas/architecture-snapshot-3.1.0.json",
  "title": "StackKits facts-only architecture snapshot v3",
  "description": "Closed downstream contract containing only StackKits-owned kit, topology, capability, placement, module, declared module compute footprint, add-on, and support-maturity facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$comment",
    "schema_version",
    "generated_at",
    "source",
    "placement_model",
    "stackkits",
    "mode_matrix",
    "modules",
    "module_profiles",
    "addons"
  ],
  "properties": {
    "$comment": {"type": "string"},
    "schema_version": {"const": "3.1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "ref", "commit"],
      "properties": {
        "repo": {"type": "string"},
        "ref": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "placement_model": {"$ref": "#/$defs/placementModel"},
    "stackkits": {
      "type": "array",
      "items": {"$ref": "#/$defs/stackkit"}
    },
    "mode_matrix": {"$ref": "#/$defs/modeMatrix"},
    "modules": {
      "type": "array",
      "items": {"$ref": "#/$defs/catalogEntry"}
    },
    "module_profiles": {
      "description": "Declared compute and accelerator footprints per Architecture v2 module contract. Undeclared axes are absent, never zero (ADR-0039). Techstack owns recommendation over them.",
      "type": "array",
      "items": {"$ref": "#/$defs/moduleProfiles"}
    },
    "addons": {
      "type": "array",
      "items": {"$ref": "#/$defs/catalogEntry"}
    }
  },
  "$defs": {
    "moduleProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "compute_profiles"],
      "properties": {
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "compute_profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/computeProfileFacts"}
        },
        "accelerator_profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/acceleratorProfileFacts"}
        }
      }
    },
    "resourceBudget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cpuCores": {"type": "number", "exclusiveMinimum": 0},
        "ramGB": {"type": "number", "exclusiveMinimum": 0},
        "storageGB": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "computeProfileFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maturity", "executable"],
      "properties": {
        "maturity": {"enum": ["experimental", "beta", "supported", "deprecated"]},
        "executable": {"type": "boolean"},
        "realization": {"enum": ["contract-only", "generation-ready", "apply-ready"]},
        "hostFloor": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minCpuCores": {"type": "number", "exclusiveMinimum": 0},
            "minRamGB": {"type": "number", "exclusiveMinimum": 0},
            "minStorageGB": {"type": "number", "exclusiveMinimum": 0},
            "minAMD64MicroarchitectureLevel": {"type": "integer", "minimum": 1, "maximum": 4},
            "allowedArchitectures": {"type": "array", "minItems": 1, "items": {"enum": ["amd64", "arm64"]}}
          }
        },
        "reservation": {"$ref": "#/$defs/resourceBudget"},
        "recommended": {"$ref": "#/$defs/resourceBudget"},
        "headroom": {"$ref": "#/$defs/resourceBudget"},
        "architectures": {"type": "array", "minItems": 1, "items": {"enum": ["amd64", "arm64"]}},
        "provenance": {"description": "Declared provenance of the numbers, carried verbatim when the module profile declares it."},
        "measuredRef": {"type": "string", "minLength": 1}
      }
    },
    "acceleratorProfileFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "access", "maturity"],
      "properties": {
        "vendor": {"enum": ["nvidia", "amd"]},
        "access": {"enum": ["cdi", "rocm-device-nodes"]},
        "minVramGiB": {"type": "number", "minimum": 1},
        "minDriverMajor": {"type": "number", "minimum": 1},
        "maturity": {"enum": ["experimental", "beta", "supported", "deprecated"]},
        "reservation": {"$ref": "#/$defs/resourceBudget"}
      }
    },
    "placementModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "modes", "sub_dimensions", "oss_realized", "control_plane_only", "note", "source_standard"],
      "properties": {
        "axis": {"const": "placementMode"},
        "modes": {
          "type": "array",
          "items": {"enum": ["local-only", "standard", "managed-serverless"]}
        },
        "sub_dimensions": {"type": "object"},
        "oss_realized": {"type": "array", "items": {"type": "string"}},
        "control_plane_only": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"},
        "source_standard": {"type": "string"}
      }
    },
    "stackkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name", "description", "version", "topology", "capabilities", "contexts", "source_path"],
      "properties": {
        "slug": {"type": "string"},
        "display_name": {"type": "string"},
        "description": {"type": "string"},
        "version": {"type": "string"},
        "topology": {"type": "object"},
        "capabilities": {"type": "object"},
        "contexts": {"type": "array", "items": {"type": "string"}},
        "source_path": {"type": "string"}
      }
    },
    "modeMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "paas_statuses", "note", "kits"],
      "properties": {
        "levels": {
          "type": "array",
          "items": {"enum": ["supported", "scaffolding", "unsupported", "control-plane"]}
        },
        "paas_statuses": {
          "type": "array",
          "items": {"enum": ["default", "supported", "draft", "experimental"]}
        },
        "note": {"type": "string"},
        "kits": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/kitModeSupport"}
        }
      }
    },
    "kitModeSupport": {
      "type": "object",
      "required": ["kit", "placement", "install", "context"],
      "properties": {
        "kit": {"type": "string"},
        "placement": {"type": "object"},
        "install": {"type": "object"},
        "context": {"type": "object"},
        "paas": {"type": "object"},
        "evidence": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name", "layer", "description", "source_path", "placement"],
      "properties": {
        "slug": {"type": "string"},
        "display_name": {"type": "string"},
        "version": {"type": "string"},
        "layer": {"type": "string"},
        "description": {"type": "string"},
        "source_path": {"type": "string"},
        "placement": {"$ref": "#/$defs/placementEligibility"}
      }
    },
    "placementEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "cf_fit", "rejection_reason"],
      "properties": {
        "supports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_only", "standard", "managed_serverless"],
          "properties": {
            "local_only": {"type": "boolean"},
            "standard": {"type": "boolean"},
            "managed_serverless": {"type": "boolean"}
          }
        },
        "cf_fit": {"type": "boolean"},
        "rejection_reason": {"type": ["string", "null"]}
      }
    }
  }
}
