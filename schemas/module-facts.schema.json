{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackkits.kombify.io/schemas/module-facts.schema.json",
  "title": "Module Facts",
  "description": "Constrained, LLM-authorable facts consumed by `stackkit module scaffold` to deterministically render a module (ADR-0027 Decision 1). The templater renders CUE from these facts plus the repo's foundation/ schemas — the facts are the only LLM-authored surface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "displayName", "description", "layer", "services"],
  "properties": {
    "facts_schema_version": { "type": "string", "const": "1.0.0" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string" },
    "layer": {
      "type": "string",
      "enum": [
        "L1-foundation",
        "L2-platform-ingress",
        "L2-platform-identity",
        "L2-platform-paas",
        "L2-platform-dns",
        "L2-platform-observability",
        "L2-platform-diagnostics",
        "L3-application"
      ]
    },
    "maturity": { "type": "string", "enum": ["draft"], "description": "Scaffolder output is always draft (ADR-0027 §5); other rungs are separate human-gated actions." },
    "core": { "type": "boolean" },
    "tool_class": { "type": "string", "enum": ["module", "addon"], "description": "Phase 1 ships modules only; addon scaffolding is a follow-up." },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minVersion": { "type": "string" },
              "provides": { "type": "array", "items": { "type": "string" } },
              "optional": { "type": "boolean" }
            }
          }
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "docker": { "type": "boolean" },
            "network": { "type": "string" },
            "dockerSocket": { "type": "boolean" },
            "persistentStorage": { "type": "boolean" },
            "minMemory": { "type": "string" },
            "arch": { "type": "string", "enum": ["amd64", "arm64", "any"] }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Placement eligibility. managed_serverless is forced false whenever dockerSocket is required (there is no host socket in that substrate).",
      "properties": {
        "localOnly": { "type": "boolean" },
        "standard": { "type": "boolean" },
        "managedServerless": { "type": "boolean" }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "healthCheck"],
      "oneOf": [
        { "required": ["image", "tag"], "not": { "required": ["imageSource"] } },
        { "required": ["imageSource"], "not": { "anyOf": [{ "required": ["image"] }, { "required": ["tag"] }] } }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "type": { "type": "string" },
        "imageSource": {
          "type": "object", "additionalProperties": false,
          "required": ["moduleRef", "componentRef"],
          "properties": { "moduleRef": { "type": "string", "minLength": 1 }, "componentRef": { "type": "string", "minLength": 1 } }
        },
        "image": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "description": "Must be a pinned semver/variant/digest; floating tags (latest/stable/...) are rejected by `stackkit module lint`." },
        "required": { "type": "boolean" },
        "needs": { "type": "array", "items": { "type": "string" } },
        "routed": { "type": "boolean" },
        "traefik": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "port"],
          "properties": {
            "rule": { "type": "string" },
            "port": { "type": "integer" }
          }
        },
        "networks": { "type": "array", "items": { "type": "string" } },
        "accessPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outerAuth"],
          "properties": {
            "outerAuth": { "type": "string" },
            "appAuth": { "type": "string" }
          }
        },
        "healthCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["http", "command"] },
            "path": { "type": "string" },
            "port": { "type": "integer" },
            "scheme": { "type": "string" },
            "command": { "type": "string" },
            "interval": { "type": "string" },
            "timeout": { "type": "string" },
            "retries": { "type": "integer" }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory": { "type": "string" },
            "memoryMax": { "type": "string" },
            "cpus": { "type": "number" }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "description": "House hardening. noNewPrivileges + capDrop ALL are enforced on render regardless of what is supplied.",
          "properties": {
            "noNewPrivileges": { "type": "boolean" },
            "capDrop": { "type": "array", "items": { "type": "string" } },
            "readOnly": { "type": "boolean" },
            "tmpfs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "type": { "type": "string", "enum": ["volume", "bind"] },
              "readOnly": { "type": "boolean" },
              "backup": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "description": "ADR-0028 watch coordinates. Watch metadata only; not part of the module contract hash.",
          "properties": {
            "github": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "registryImage": { "type": "string" },
            "track": { "type": "string", "enum": ["patch", "minor", "major"] },
            "pinLine": { "type": "string" },
            "osv": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ecosystem", "name"],
              "properties": {
                "ecosystem": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          }
        },
        "subdomain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "nested", "flat"],
          "properties": {
            "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "nested": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "flat": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          }
        }
      }
    }
  }
}
