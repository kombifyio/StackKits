{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackkits.kombify.io/schemas/stackkit-rollout-event.schema.json",
  "title": "StackKit Rollout Progress Event",
  "description": "Redacted stackkit.rollout-event/v1 JSONL event emitted by StackKit CLI rollout, prepare, Advanced and host maintenance phases (--progress-jsonl).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "time",
    "phase",
    "status"
  ],
  "properties": {
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "prepare",
        "target.connect",
        "apt_wait",
        "docker.install",
        "opentofu.check",
        "terramate.check",
        "telemetry.handshake",
        "resources.check",
        "advanced.change-set.materialize-host",
        "advanced.change-set.run-order",
        "advanced.change-set.converge",
        "advanced.change-set.reconcile",
        "advanced.drift.stack",
        "advanced.restore-drill.verify-runtime",
        "advanced.restore-drill.backup",
        "advanced.restore-drill.select-anchor",
        "advanced.restore-drill.stage-restore",
        "advanced.restore-drill.verify-staged-restore",
        "advanced.restore-drill.cleanup-staging",
        "advanced.restore-drill.verify-live-unchanged",
        "host.updates.refresh",
        "host.updates.simulate",
        "host.updates.install",
        "host.reboot.schedule"
      ]
    },
    "status": {
      "description": "Lifecycle phases report started, running, succeeded, failed or skipped. The per-stack Advanced phases advanced.change-set.converge and advanced.drift.stack report the stack status instead: converged, drifted, failed, pending_root or (change sets only) other_host; advanced.change-set.reconcile reports converged or failed; advanced.rollback.stack reports converged, failed or skipped. docs/data/advanced-operations/latest.json lists the statuses per phase.",
      "type": "string",
      "enum": [
        "started",
        "running",
        "succeeded",
        "failed",
        "skipped",
        "converged",
        "drifted",
        "pending_root",
        "other_host"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "message": {
      "type": "string"
    },
    "failureClass": {
      "type": "string",
      "enum": [
        "acme_rate_limited",
        "apt_lock_timeout",
        "apt_process_timeout",
        "apt_wait_timeout",
        "cancelled",
        "clock_skew",
        "cloud_init_timeout",
        "dependency_unhealthy",
        "disk_full",
        "docker_bridge_failed",
        "docker_daemon_failed",
        "docker_install_failed",
        "docker_missing",
        "docker_socket_denied",
        "health_timeout",
        "image_arch_mismatch",
        "image_not_found",
        "image_pull_denied",
        "kernel_namespace_blocked",
        "oom_killed",
        "opentofu_prepare_failed",
        "platform_app_failed",
        "port_conflict",
        "registry_rate_limited",
        "registry_unreachable",
        "secret_unavailable",
        "spec_fetch_failed",
        "target_inspect_failed",
        "terramate_prepare_failed",
        "tofu_apply_failed",
        "tofu_init_failed",
        "unattended_upgrade_timeout",
        "unknown_failure",
        "verify_failed"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
