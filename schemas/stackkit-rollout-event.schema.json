{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackkits.kombify.io/schemas/stackkit-rollout-event.schema.json",
  "title": "StackKit Rollout Progress Event",
  "description": "Redacted JSONL event emitted by StackKit CLI rollout and prepare phases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "time",
    "phase",
    "status"
  ],
  "properties": {
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "prepare",
        "target.connect",
        "apt_wait",
        "docker.install",
        "opentofu.check",
        "terramate.check",
        "telemetry.handshake",
        "resources.check"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "running",
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "message": {
      "type": "string"
    },
    "failureClass": {
      "type": "string",
      "enum": [
        "apt_lock_timeout",
        "apt_process_timeout",
        "apt_wait_timeout",
        "cancelled",
        "clock_skew",
        "cloud_init_timeout",
        "dependency_unhealthy",
        "disk_full",
        "docker_bridge_failed",
        "docker_daemon_failed",
        "docker_install_failed",
        "docker_missing",
        "docker_socket_denied",
        "health_timeout",
        "image_arch_mismatch",
        "image_not_found",
        "image_pull_denied",
        "kernel_namespace_blocked",
        "oom_killed",
        "opentofu_prepare_failed",
        "platform_app_failed",
        "port_conflict",
        "registry_rate_limited",
        "registry_unreachable",
        "secret_unavailable",
        "spec_fetch_failed",
        "target_inspect_failed",
        "terramate_prepare_failed",
        "tofu_apply_failed",
        "tofu_init_failed",
        "unattended_upgrade_timeout",
        "unknown_failure",
        "verify_failed"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
