{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackkit.cc/schemas/stackkits-use-case-catalog-v1.schema.json",
  "title": "StackKits release use-case catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "generatedAt", "generatorVersion", "catalog", "contentDigest"],
  "properties": {
    "schemaVersion": { "const": "stackkits-use-case-catalog/v1" },
    "release": { "$ref": "#/$defs/release" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useCases"],
      "properties": {
        "useCases": {
          "type": "array",
          "items": { "$ref": "#/$defs/useCase" }
        }
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "version", "sourceSha", "publicSourceSha", "releaseUrl"],
      "properties": {
        "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "publicSourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "releaseUrl": { "type": "string", "pattern": "^https://github\\.com/kombifyio/StackKits/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary", "alternative", "supporting", "connector", "bridge"] },
        "kind": { "enum": ["application", "module", "service", "connector", "bridge"] }
      }
    },
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "components"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
      }
    }
  }
}
