{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackkit.cc/schemas/stackkits-use-case-catalog-v1.schema.json",
  "title": "StackKits release use-case catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "generatedAt", "generatorVersion", "catalog", "contentDigest"],
  "properties": {
    "schemaVersion": { "const": "stackkits-use-case-catalog/v1" },
    "release": { "$ref": "#/$defs/release" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useCases"],
      "properties": {
        "useCases": {
          "type": "array",
          "items": { "$ref": "#/$defs/useCase" }
        }
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "version", "sourceSha", "publicSourceSha", "releaseUrl"],
      "properties": {
        "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "publicSourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "releaseUrl": { "type": "string", "pattern": "^https://github\\.com/kombifyio/StackKits/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary", "alternative", "supporting", "connector", "bridge"] },
        "kind": { "enum": ["application", "module", "service", "connector", "bridge"] }
      }
    },
    "useCaseLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residency", "baseline", "burst"],
      "properties": {
        "residency": { "enum": ["always-on", "on-demand", "scheduled"] },
        "baseline": { "enum": ["none", "idle-resident", "active-resident"] },
        "burst": { "enum": ["none", "interactive", "ingest", "batch"] }
      }
    },
    "useCaseComputeTierFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included"],
      "properties": {
        "included": { "type": "boolean" },
        "functions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "load": { "$ref": "#/$defs/useCaseLoad" },
        "moduleSlug": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "reason": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "useCaseSettingOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "useCaseSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "group", "depth", "default", "realization"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["choice", "toggle", "text"] },
        "group": { "type": "string", "enum": ["backend", "profile", "storage", "hardware", "access", "features"] },
        "depth": { "type": "string", "enum": ["summary", "advanced"] },
        "help": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/useCaseSettingOption" } },
        "default": { "type": ["string", "boolean"] },
        "placeholder": { "type": "string" },
        "realization": { "type": "string", "enum": ["install", "recorded"] }
      }
    },
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "components"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
        "computeTiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "standard", "high"],
          "properties": {
            "low": { "$ref": "#/$defs/useCaseComputeTierFit" },
            "standard": { "$ref": "#/$defs/useCaseComputeTierFit" },
            "high": { "$ref": "#/$defs/useCaseComputeTierFit" }
          }
        },
        "settings": { "type": "array", "items": { "$ref": "#/$defs/useCaseSetting" } },
        "docs": { "type": "string", "pattern": "^/[a-z0-9/-]+$" }
      }
    }
  }
}
