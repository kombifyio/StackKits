  "kind": "KitDefinition",
  "metadata": {
    "description": "Local-first StackKit for one or more nodes on private home sites",
    "displayName": "Basement Kit",
    "slug": "basement-kit",
    "version": "5.1.0"
  },
  "network": {
    "defaultDomain": "home.test",
    "defaultTLSMode": "internal",
    "domainRequired": false,
    "mode": "private"
  },
  "partitionPolicy": {
    "cloudEdge": "not-applicable",
    "denyNewCrossSiteSessions": true,
    "localIdentityAuthorityAvailable": true,
    "maxStaleVerificationSeconds": 0,
    "onCloudLoss": "not-applicable",
    "onLinkLoss": "local-continues"
  },
  "reachability": {
    "accessPolicies": {
      "allowedExposures": [
        "private",
        "lan",
        "public"
      ],
      "lanStepDownAllowed": true
    },
    "routes": {
      "local": {
        "allowed": true,
        "allowedOriginKinds": [
          "home"
        ],
        "requiredRealizations": []
      },
      "public": {
        "allowed": true,
        "allowedOriginKinds": [
          "home"
        ],
        "requiredRealizations": [
          {
            "capabilityRef": "public-publish-egress",
            "role": "egress"
          }
        ]
      },
      "remote-private": {
        "allowed": true,
        "allowedOriginKinds": [
          "home"
        ],
        "requiredRealizations": [
          {
            "capabilityRef": "private-remote-access",
            "role": "access"
          }
        ]
      }
    }
  },
  "redactionPolicy": {
    "enforcement": "required",
    "exportedEvidence": "redacted-only",
    "logs": "redacted-only",
    "opaqueReferences": "preserved",
    "sensitiveValues": "redacted"
  },
  "topology": {
    "allowedSiteKinds": [
      "home"
    ],
    "controlPlane": {
      "allowedAuthorityKinds": [
        "home"
      ],
      "allowedModes": [
        "single",
        "warm-standby",
        "quorum"
      ],
      "defaultMode": "single",
      "memberSiteScope": "any"
    },
    "maxSites": 1,
    "minSites": 1,
    "multiNode": true,
    "requiredSiteKinds": [
      "home"
    ]
  },
  "upgradePolicy": {
    "liveVolumeCutoverAvailable": false,
    "ownerApprovalRequired": true,
    "rollbackAnchorRequired": true,
    "snapshotRequired": true,
    "support": "preview"
  },
  "workloads": {
    "defaults": [],
    "forbidden": [],
    "optional": [
      "files",
      "photos",
      "vault"
    ],
    "required": [
      "basement-core"
    ]
  }
}
