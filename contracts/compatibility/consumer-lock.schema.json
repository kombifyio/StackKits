{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kombify:runtime-contract-consumer-lock:v2",
  "title": "Kombify runtime contract consumer lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modulePath",
    "moduleVersion",
    "moduleSum",
    "packages",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "kombify.runtime-contract-consumer-lock/v2"
    },
    "modulePath": {
      "const": "github.com/kombifyio/stackkits"
    },
    "moduleVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "moduleSum": {
      "type": "string",
      "pattern": "^h1:[A-Za-z0-9+/]{43}=$"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "contracts/advancedcapability",
          "contracts/applyevidence",
          "contracts/datasubject",
          "contracts/providerexecutor/v1beta1",
          "contracts/runtimeapply",
          "contracts/runtimeexecutor",
          "contracts/runtimeinventory",
          "contracts/runtimelease",
          "contracts/stackaction"
        ]
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
