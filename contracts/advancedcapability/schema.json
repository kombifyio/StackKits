{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kombify:stackkit:advanced-capability:v1",
  "title": "Advanced capability and trust bundle wire",
  "description": "Generated by advancedcapabilitygen/v1 from contract.json. Documents are exact RFC 8785 (JCS) bytes; the capability signature is Ed25519 over SHA-256(schemaVersion || 0x00 || unsigned JCS).",
  "oneOf": [
    {
      "$ref": "#/$defs/Capability"
    },
    {
      "$ref": "#/$defs/TrustBundle"
    }
  ],
  "$defs": {
    "Capability": {
      "description": "Capability is one stackkit.advanced-capability/v1 document. Its canonical bytes are RFC 8785 (JCS): members in code-point order, no whitespace, and every value validated ASCII.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOperations",
        "audience",
        "capabilityId",
        "expiresAt",
        "issuedAt",
        "issuerId",
        "keyId",
        "ownerRef",
        "rilRef",
        "schemaVersion",
        "signature",
        "stackId",
        "uiManagerRef"
      ],
      "properties": {
        "allowedOperations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "application-transfer.retire",
              "drift.reconcile.advanced",
              "public-tls.origin-certificate.install",
              "public-tls.origin-certificate.request",
              "restore.drill",
              "rollback.coordinated",
              "terramate.change-set.apply",
              "terramate.change-set.create"
            ]
          },
          "description": "AllowedOperations is the sorted, duplicate-free operation set."
        },
        "audience": {
          "type": "string",
          "const": "stackkit"
        },
        "backupRenewal": {
          "$ref": "#/$defs/BackupRenewal",
          "description": "BackupRenewal is present only on a single short-lived restore.drill capability."
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "CapabilityID is a lowercase UUIDv7."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "x-kombify-format": "rfc3339-utc-seconds"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "x-kombify-format": "rfc3339-utc-seconds"
        },
        "issuerId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "description": "IssuerID names a Techstack issuer (see IssuerClass)."
        },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519://sha256/[0-9a-f]{64}$",
          "description": "KeyID is ed25519://sha256/\u003chex SHA-256 of the raw public key\u003e."
        },
        "ownerRef": {
          "type": "string",
          "pattern": "^owner/local/[0-9a-f]{32}$"
        },
        "rilRef": {
          "type": "string",
          "x-kombify-format": "logical-reference"
        },
        "schemaVersion": {
          "type": "string",
          "const": "stackkit.advanced-capability/v1"
        },
        "signature": {
          "type": "string",
          "x-kombify-format": "ed25519-signature",
          "description": "Signature is the unpadded standard-Base64 Ed25519 signature over SigningDigest of the unsigned canonical bytes."
        },
        "stackId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "transferRetirement": {
          "$ref": "#/$defs/TransferRetirement",
          "description": "TransferRetirement binds a short-lived retirement to the exact existing held snapshot, signed peer outcome and canonical desired-intent transition."
        },
        "uiManagerRef": {
          "type": "string",
          "x-kombify-format": "logical-reference"
        }
      }
    },
    "BackupRenewal": {
      "description": "BackupRenewal authorizes one local staged drill against unchanged applied authority after fresh managed entitlement, usage and remote target attestation. It grants no remote snapshot or data activation authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "bindingHash",
        "custodyAttestationRef",
        "deploymentId",
        "freshAttestationRef",
        "jobId",
        "measuredAt",
        "planHash",
        "quotaBytes",
        "repositoryId",
        "targetRef",
        "tenantId",
        "usedBytes"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:@|.-]{1,180}$"
        },
        "bindingHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "custodyAttestationRef": {
          "type": "string",
          "pattern": "^backup-custody-attestation://sha256/[0-9a-f]{64}$"
        },
        "deploymentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:@|.-]{1,180}$"
        },
        "freshAttestationRef": {
          "type": "string",
          "pattern": "^backup-custody-attestation://sha256/[0-9a-f]{64}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{7,99}$"
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time",
          "x-kombify-format": "rfc3339-utc"
        },
        "planHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "quotaBytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "repositoryId": {
          "type": "string",
          "const": "kopia:local:cloud"
        },
        "targetRef": {
          "type": "string",
          "pattern": "^backup-target://sha256/[0-9a-f]{64}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:@|.-]{1,180}$"
        },
        "usedBytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      }
    },
    "TransferRetirement": {
      "description": "TransferRetirement authorizes only selected intent retirement within its original held snapshot after the signed peer outcome is verified. It grants no runtime activation, source restart, data deletion, server or provider authority. The consumer must reconstruct and compare every field from its authenticated journal and canonical candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineSpecHash",
        "candidateSpecHash",
        "operationId",
        "outcomeDigest",
        "role",
        "transferId"
      ],
      "properties": {
        "baselineSpecHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "candidateSpecHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "outcomeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "pattern": "^(source|destination)$"
        },
        "transferId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "TrustBundle": {
      "description": "TrustBundle is one stackkit.advanced-trust-bundle/v1 document. It holds public verification keys only; the Owner imports it pinned by Digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "schemaVersion"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/TrustBundleKey"
          }
        },
        "schemaVersion": {
          "type": "string",
          "const": "stackkit.advanced-trust-bundle/v1"
        }
      }
    },
    "TrustBundleKey": {
      "description": "TrustBundleKey binds one Techstack issuer to one raw Ed25519 public key.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerId",
        "keyId",
        "publicKey"
      ],
      "properties": {
        "issuerId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519://sha256/[0-9a-f]{64}$"
        },
        "publicKey": {
          "type": "string",
          "x-kombify-format": "ed25519-public-key",
          "description": "PublicKey is the unpadded standard-Base64 raw 32-byte Ed25519 public key."
        }
      }
    }
  }
}
